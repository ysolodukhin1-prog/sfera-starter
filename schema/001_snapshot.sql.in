    CONSTRAINT cognitive_foundation_relations_confidence_check CHECK (((confidence >= (0)::numeric) AND (confidence <= (1)::numeric))),
    CONSTRAINT cognitive_foundation_relations_mapping_kind_check CHECK ((mapping_kind = ANY (ARRAY['evidence'::text, 'engineering'::text]))),
    CONSTRAINT cognitive_foundation_relations_relation_type_check CHECK ((relation_type = ANY (ARRAY['SUPPORTS'::text, 'CONTRADICTS'::text, 'DERIVED_FROM'::text, 'APPLIES_TO'::text, 'IMPLEMENTS'::text]))),
    CONSTRAINT cognitive_foundation_relations_status_check CHECK ((status = ANY (ARRAY['active'::text, 'retired'::text])))
);


