--
-- Name: acl_can(text, text, text, text, text); Type: FUNCTION; Schema: galactica_autonomy; Owner: -
--

CREATE FUNCTION galactica_autonomy.acl_can(subject text, kind text, resource text, area text, requested text) RETURNS boolean
    LANGUAGE plpgsql STABLE SECURITY DEFINER
    SET search_path TO 'pg_catalog'
    AS $$
#variable_conflict use_variable
DECLARE allowed boolean; item_section text;
BEGIN
 IF subject IS NULL OR subject='' OR requested NOT IN ('read','create','edit','manage') THEN RETURN false; END IF;
 IF current_setting('galactica.acl.admin',true)='true' THEN RETURN true; END IF;
 SELECT m.section_key INTO item_section FROM galactica_autonomy.acl_material_sections m
 WHERE m.kind=acl_can.kind AND m.resource_key=resource;
 item_section:=COALESCE(item_section,area);
 WITH RECURSIVE ancestors AS (
  SELECT s.key,s.parent_key,0 AS distance FROM galactica_autonomy.acl_sections s WHERE s.key=item_section
  UNION ALL SELECT s.key,s.parent_key,a.distance+1 FROM galactica_autonomy.acl_sections s
  JOIN ancestors a ON s.key=a.parent_key WHERE a.distance<16
 ), matches AS (
 SELECT r.effect,
  CASE r.scope_kind WHEN 'material' THEN 100 WHEN 'section' THEN 50-COALESCE(a.distance,0) ELSE 0 END AS specificity,
  CASE r.subject_kind WHEN 'user' THEN 2 WHEN 'group' THEN 1 ELSE 0 END AS priority
 FROM galactica_autonomy.acl_rules r LEFT JOIN ancestors a ON r.scope_kind='section' AND r.scope_key=a.key
 WHERE r.action=requested
  AND ((r.scope_kind='root' AND r.scope_key='*') OR (r.scope_kind='section' AND a.key IS NOT NULL)
    OR (r.scope_kind='material' AND r.scope_key=kind||':'||resource))
  AND ((r.subject_kind='everyone' AND r.subject_key='*') OR (r.subject_kind='user' AND r.subject_key=subject)
    OR (r.subject_kind='group' AND EXISTS(SELECT 1 FROM galactica_autonomy.acl_group_members gm
          WHERE gm.group_id::text=r.subject_key AND gm.subject=subject)))
 ), best AS (SELECT * FROM matches ORDER BY specificity DESC,priority DESC LIMIT 1)
 SELECT bool_and(m.effect='allow') INTO allowed FROM matches m,best b
 WHERE m.specificity=b.specificity AND m.priority=b.priority;
 RETURN COALESCE(allowed,false);
END $$;


--
-- Name: acl_manages(text, text); Type: FUNCTION; Schema: galactica_autonomy; Owner: -
--

CREATE FUNCTION galactica_autonomy.acl_manages(scope_type text, scope text) RETURNS boolean
    LANGUAGE plpgsql STABLE SECURITY DEFINER
    SET search_path TO 'pg_catalog'
    AS $$
#variable_conflict use_variable
DECLARE subject text:=current_setting('galactica.acl.subject',true);kind text;resource text;area text;
BEGIN
 IF current_setting('galactica.acl.admin',true)='true' THEN RETURN true; END IF;
 IF scope_type='root' THEN RETURN galactica_autonomy.acl_can(subject,'root','*','','manage'); END IF;
 IF scope_type='section' THEN RETURN galactica_autonomy.acl_can(subject,'section',scope,scope,'manage'); END IF;
 kind:=split_part(scope,':',1);resource:=substr(scope,length(kind)+2);
 IF kind='knowledge' THEN SELECT k.area_key INTO area FROM galactica_autonomy.knowledge k WHERE k.id::text=resource AND k.project_id='@@PROJECT_ID@@';
 ELSIF kind='document' THEN SELECT d.area_key INTO area FROM galactica_autonomy.documents d WHERE d.id::text=resource AND d.project_id='@@PROJECT_ID@@';
 ELSIF kind='skill' THEN area:='skills';
 ELSE RETURN false; END IF;
 RETURN area IS NOT NULL AND galactica_autonomy.acl_can(subject,kind,resource,area,'manage');
END $$;


--
-- Name: acl_own_task(text); Type: FUNCTION; Schema: galactica_autonomy; Owner: -
--

CREATE FUNCTION galactica_autonomy.acl_own_task(actor text) RETURNS boolean
    LANGUAGE sql STABLE SECURITY DEFINER
    SET search_path TO 'pg_catalog'
    AS $$
 SELECT current_setting('galactica.acl.admin',true)='true' OR EXISTS(
 SELECT 1 FROM public.access_principals p WHERE p.external_subject=
 'trend:https://sfera.invalid:user:'||current_setting('galactica.acl.subject',true)
 AND p.status='active' AND actor='client-mcp:user:'||p.id::text)
$$;


--
-- Name: classify_document_area(); Type: FUNCTION; Schema: galactica_autonomy; Owner: -
--

CREATE FUNCTION galactica_autonomy.classify_document_area() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
  IF NEW.area_key IS NOT NULL AND (TG_OP = 'INSERT' OR
      NEW.area_key IS DISTINCT FROM OLD.area_key) THEN
    RETURN NEW;
  END IF;
  NEW.area_key := CASE
    WHEN NEW.relative_path='USERPROFILE.md' THEN 'user'
    WHEN NEW.relative_path LIKE 'CLIENT/skills/%' THEN 'skills'
    WHEN NEW.relative_path LIKE 'CLIENT/%' THEN 'work'
    ELSE 'self' END;
  RETURN NEW;
END $$;


--
-- Name: classify_knowledge_area(); Type: FUNCTION; Schema: galactica_autonomy; Owner: -
--

CREATE FUNCTION galactica_autonomy.classify_knowledge_area() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
DECLARE assigned text;
BEGIN
  IF NEW.area_key IS NOT NULL AND (TG_OP = 'INSERT' OR
      (NEW.area_key IS DISTINCT FROM OLD.area_key AND NEW.area_key IS NOT NULL)) THEN
    NEW.classification_basis := COALESCE(NEW.classification_basis,'curated');
    RETURN NEW;
  END IF;
  SELECT default_area INTO assigned FROM galactica_autonomy.entity_kinds WHERE key=NEW.kind;
  IF assigned IS NULL THEN
    RAISE EXCEPTION 'Unknown CLIENT entity kind: %', NEW.kind;
  END IF;
  IF NEW.source_spans @> '[{"source_system":"codex_local"}]'::jsonb THEN
    assigned := 'threads';
    NEW.classification_basis := 'source';
  ELSE
    NEW.classification_basis := 'kind';
  END IF;
  NEW.area_key := assigned;
  RETURN NEW;
END $$;


--
-- Name: client_mcp_identity(uuid, text); Type: FUNCTION; Schema: galactica_autonomy; Owner: -
--

CREATE FUNCTION galactica_autonomy.client_mcp_identity(credential uuid, cookie_hash text) RETURNS TABLE(credential_id uuid, principal_id uuid, expires_at timestamp with time zone, role text)
    LANGUAGE sql SECURITY DEFINER
    SET search_path TO 'pg_catalog'
    AS $$
 SELECT c.id,c.principal_id,c.expires_at,m.role
 FROM public.auth_credentials c
 JOIN public.access_principals p ON p.id=c.principal_id
 JOIN public.account_memberships m ON m.principal_id=p.id
 JOIN public.accounts a ON a.id=m.account_id
 JOIN public.projects pr ON pr.account_id=a.id
 WHERE c.kind='browser' AND c.revoked_at IS NULL AND c.expires_at>clock_timestamp()
   AND p.kind='user' AND p.status='active' AND m.status='active' AND a.status='active'
   AND a.account_key='sfera-owner' AND pr.id='@@PROJECT_ID@@'
   AND (pr.visibility_scope='account' OR (pr.visibility_scope='private' AND pr.owner_principal_id=p.id))
   AND (credential IS NOT NULL OR cookie_hash IS NOT NULL)
   AND (credential IS NULL OR c.id=credential)
   AND (cookie_hash IS NULL OR c.token_hash=cookie_hash)
$$;


--
-- Name: client_mcp_source_activity(uuid, text, text, timestamp with time zone); Type: FUNCTION; Schema: galactica_autonomy; Owner: -
--

CREATE FUNCTION galactica_autonomy.client_mcp_source_activity(credential uuid, subject text, encrypted_token text, expiry timestamp with time zone) RETURNS boolean
    LANGUAGE plpgsql SECURITY DEFINER
    SET search_path TO 'pg_catalog'
    AS $_$
BEGIN
 IF expiry<=clock_timestamp() OR expiry>clock_timestamp()+interval '3 hours 5 seconds'
 OR length(encrypted_token) NOT BETWEEN 1 AND 8192 OR subject !~ '^[1-9][0-9]*$' THEN
   RAISE EXCEPTION 'Invalid session renewal';
 END IF;
 PERFORM 1 FROM public.auth_credentials c
 JOIN galactica_autonomy.client_mcp_source_sessions s ON s.credential_id=c.id
 WHERE c.id=credential AND c.kind='browser' AND c.revoked_at IS NULL AND c.expires_at>clock_timestamp()
 AND s.source_subject=subject AND s.revoked_at IS NULL AND s.expires_at>clock_timestamp()
 FOR UPDATE OF c,s;
 IF NOT FOUND THEN RETURN false; END IF;
 UPDATE public.auth_credentials SET expires_at=expiry WHERE id=credential;
 UPDATE galactica_autonomy.client_mcp_source_sessions
 SET expires_at=expiry,encrypted_session=encrypted_token WHERE credential_id=credential;
 UPDATE galactica_autonomy.client_mcp_refresh_tokens SET expires_at=expiry
 WHERE credential_id=credential AND revoked_at IS NULL AND consumed_at IS NULL;
 RETURN true;
END $_$;


--
-- Name: client_mcp_source_login(text, text, text, text, timestamp with time zone, text); Type: FUNCTION; Schema: galactica_autonomy; Owner: -
--

CREATE FUNCTION galactica_autonomy.client_mcp_source_login(subject text, display_name text, cookie_hash text, encrypted_session text, expiry timestamp with time zone, source_role text) RETURNS TABLE(credential_id uuid, principal_id uuid)
    LANGUAGE plpgsql SECURITY DEFINER
    SET search_path TO 'pg_catalog'
    AS $_$
#variable_conflict use_column
DECLARE p uuid; c uuid; a uuid;
BEGIN
 IF subject !~ '^[1-9][0-9]*$' OR cookie_hash !~ '^[0-9a-f]{64}$'
 OR source_role NOT IN ('reader','contributor','manager')
 OR expiry<=clock_timestamp() OR expiry>clock_timestamp()+interval '31 days'
 OR length(display_name) NOT BETWEEN 1 AND 120 OR length(encrypted_session)>8192 THEN
  RAISE EXCEPTION 'Invalid source login';
 END IF;
 SELECT id INTO a FROM public.accounts WHERE account_key='sfera-owner' AND status='active';
 IF a IS NULL THEN RAISE EXCEPTION 'Account unavailable'; END IF;
 INSERT INTO public.access_principals(kind,display_name,external_subject,status,is_superuser)
 VALUES ('user',display_name,'trend:https://sfera.invalid:user:'||subject,'active',false)
 ON CONFLICT(external_subject) DO NOTHING;
 SELECT id INTO p FROM public.access_principals
 WHERE external_subject='trend:https://sfera.invalid:user:'||subject AND kind='user' AND status='active' AND NOT is_superuser;
 IF p IS NULL THEN RAISE EXCEPTION 'Identity disabled'; END IF;
 INSERT INTO public.account_memberships(account_id,principal_id,role,status)
 VALUES (a,p,source_role,'active') ON CONFLICT(account_id,principal_id) DO UPDATE
 SET role=EXCLUDED.role,updated_at=clock_timestamp() WHERE public.account_memberships.status='active';
 IF NOT EXISTS(SELECT 1 FROM public.account_memberships WHERE account_id=a AND principal_id=p AND status='active') THEN
  RAISE EXCEPTION 'Membership disabled';
 END IF;
 INSERT INTO public.auth_credentials(principal_id,token_hash,kind,label,expires_at)
 VALUES(p,cookie_hash,'browser','TREND unified MCP',expiry) RETURNING id INTO c;
 INSERT INTO galactica_autonomy.client_mcp_source_sessions(credential_id,source_subject,encrypted_session,expires_at)
 VALUES(c,subject,encrypted_session,expiry);
 INSERT INTO public.auth_audit_events(actor_id,action,target_id,credential_id,account_id,project_id)
 VALUES(p,'client_mcp_trend_login',p,c,a,'@@PROJECT_ID@@');
 RETURN QUERY SELECT c,p;
END $_$;


--
-- Name: enqueue_outcome_links(); Type: FUNCTION; Schema: galactica_autonomy; Owner: -
--

CREATE FUNCTION galactica_autonomy.enqueue_outcome_links() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
 INSERT INTO galactica_autonomy.outcome_link_jobs(task_id)
 VALUES(NEW.task_id) ON CONFLICT DO NOTHING;
 RETURN NEW;
END $$;


--
-- Name: validate_relation_assertion(); Type: FUNCTION; Schema: galactica_autonomy; Owner: -
--

CREATE FUNCTION galactica_autonomy.validate_relation_assertion() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
DECLARE source_project uuid; target_project uuid;
BEGIN
  SELECT project_id INTO source_project FROM galactica_autonomy.knowledge WHERE id=NEW.source_id;
  SELECT project_id INTO target_project FROM galactica_autonomy.knowledge WHERE id=NEW.target_id;
  IF source_project IS DISTINCT FROM target_project THEN
    RAISE EXCEPTION 'Cross-project knowledge relation is not allowed';
  END IF;
  IF NEW.verification_status='source_backed' AND NOT EXISTS (
    SELECT 1 FROM galactica_autonomy.messages m
    WHERE m.id=ANY(NEW.evidence_message_ids) AND m.completeness='exact'
  ) THEN
    RAISE EXCEPTION 'Source-backed relation requires an exact archived message';
  END IF;
  RETURN NEW;
END $$;


