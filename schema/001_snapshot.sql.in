    CONSTRAINT source_exchange_staging_credential_ciphertext_check CHECK (((octet_length(credential_ciphertext) >= 100) AND (octet_length(credential_ciphertext) <= 8192))),
    CONSTRAINT source_exchange_staging_credential_digest_check CHECK ((credential_digest ~ '^[0-9a-f]{64}$'::text)),
    CONSTRAINT source_exchange_staging_source_subject_key_check CHECK ((source_subject_key ~ '^[1-9][0-9]{0,18}$'::text)),
    CONSTRAINT source_exchange_staging_source_user_revision_check CHECK (((length(source_user_revision) >= 1) AND (length(source_user_revision) <= 64)))
);

