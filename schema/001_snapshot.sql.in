--
-- Name: run_node_usages; Type: TABLE; Schema: public; Owner: -
--

CREATE TABLE public.run_node_usages (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    run_id uuid NOT NULL,
    event_id uuid NOT NULL,
    semantic_node_id uuid NOT NULL,
    usage_stage text NOT NULL,
    effect text DEFAULT 'unknown'::text NOT NULL,
    effect_details jsonb DEFAULT '{}'::jsonb NOT NULL,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    signal_class text DEFAULT 'explicit'::text NOT NULL,
    CONSTRAINT run_node_usages_check CHECK (((usage_stage <> 'verified'::text) OR (effect <> 'unknown'::text))),
    CONSTRAINT run_node_usages_effect_check CHECK ((effect = ANY (ARRAY['unknown'::text, 'positive'::text, 'neutral'::text, 'negative'::text]))),
    CONSTRAINT run_node_usages_effect_details_check CHECK (((jsonb_typeof(effect_details) = 'object'::text) AND (NOT public.runtime_jsonb_has_forbidden_run_key(effect_details)))),
    CONSTRAINT run_node_usages_signal_class_check CHECK ((signal_class = ANY (ARRAY['explicit'::text, 'derived'::text]))),
    CONSTRAINT run_node_usages_usage_stage_check CHECK ((usage_stage = ANY (ARRAY['referenced'::text, 'applied'::text, 'verified'::text])))
);


--
-- Name: learning_effect_funnel_v; Type: VIEW; Schema: public; Owner: -
--

CREATE VIEW public.learning_effect_funnel_v AS
 WITH stage_events AS (
         SELECT ar.id AS run_id,
            cpn.semantic_node_id,
            'returned'::text AS stage,
            'unknown'::text AS effect
           FROM (public.agent_runs ar
             JOIN public.cognitive_pack_nodes cpn ON ((cpn.pack_id = ar.cognitive_pack_id)))
        UNION ALL
         SELECT ar.id,
            node_id.node_id,
            'referenced'::text AS text,
            'unknown'::text AS text
           FROM (public.agent_runs ar
             CROSS JOIN LATERAL unnest(ar.referenced_semantic_node_ids) node_id(node_id))
        UNION ALL
         SELECT run_node_usages.run_id,
            run_node_usages.semantic_node_id,
            run_node_usages.usage_stage,
            run_node_usages.effect
           FROM public.run_node_usages
        ), collapsed AS (
         SELECT event.run_id,
            event.semantic_node_id,
            bool_or((event.stage = 'returned'::text)) AS raw_returned,
            bool_or((event.stage = 'referenced'::text)) AS raw_referenced,
            bool_or((event.stage = 'applied'::text)) AS raw_applied,
            bool_or((event.stage = 'verified'::text)) AS raw_verified,
            bool_or(((event.stage = 'verified'::text) AND (event.effect = 'positive'::text))) AS raw_positive,
            bool_or(((event.stage = 'verified'::text) AND (event.effect = 'negative'::text))) AS raw_negative
           FROM stage_events event
          GROUP BY event.run_id, event.semantic_node_id
        )
 SELECT collapsed.run_id,
    collapsed.semantic_node_id,
    collapsed.raw_returned AS returned,
    (collapsed.raw_returned AND collapsed.raw_referenced) AS referenced,
    (collapsed.raw_returned AND collapsed.raw_referenced AND collapsed.raw_applied) AS applied,
    (collapsed.raw_returned AND collapsed.raw_referenced AND collapsed.raw_applied AND collapsed.raw_verified) AS verified,
    (collapsed.raw_returned AND collapsed.raw_referenced AND collapsed.raw_applied AND collapsed.raw_verified AND collapsed.raw_positive) AS positive_effect,
    (collapsed.raw_returned AND collapsed.raw_referenced AND collapsed.raw_applied AND collapsed.raw_verified AND collapsed.raw_negative) AS negative_effect,
    run.started_at AS run_started_at,
    run.status AS run_status
   FROM (collapsed
     JOIN public.agent_runs run ON ((run.id = collapsed.run_id)));


