    CONSTRAINT skill_versions_usage_count_check CHECK ((usage_count >= 0)),
    CONSTRAINT skill_versions_version_check CHECK ((version > 0))
);


--
-- Name: source_authorization_attempts; Type: TABLE; Schema: public; Owner: -
--

CREATE TABLE public.source_authorization_attempts (
    id uuid NOT NULL,
    principal_id uuid NOT NULL,
    credential_id uuid NOT NULL,
    account_id uuid NOT NULL,
    service_key text NOT NULL,
    instance_id uuid NOT NULL,
    origin text NOT NULL,
    client_id text NOT NULL,
    redirect_uri text NOT NULL,
    state_hash text NOT NULL,
    pkce_challenge text NOT NULL,
    secret_ciphertext bytea NOT NULL,
    status text DEFAULT 'pending'::text NOT NULL,
    code_hash text,
    created_at timestamp with time zone DEFAULT clock_timestamp() NOT NULL,
    expires_at timestamp with time zone DEFAULT (clock_timestamp() + '00:10:00'::interval) NOT NULL,
    changed_at timestamp with time zone,
    CONSTRAINT source_authorization_attempts_check CHECK (((expires_at > created_at) AND (expires_at <= (created_at + '00:11:00'::interval)))),
    CONSTRAINT source_authorization_attempts_check1 CHECK (((status = 'pending'::text) = (changed_at IS NULL))),
    CONSTRAINT source_authorization_attempts_check2 CHECK (((status = 'exchanging'::text) = (code_hash IS NOT NULL))),
    CONSTRAINT source_authorization_attempts_code_hash_check CHECK ((code_hash ~ '^[0-9a-f]{64}$'::text)),
    CONSTRAINT source_authorization_attempts_pkce_challenge_check CHECK ((pkce_challenge ~ '^[A-Za-z0-9_-]{43}$'::text)),
    CONSTRAINT source_authorization_attempts_secret_ciphertext_check CHECK (((octet_length(secret_ciphertext) >= 100) AND (octet_length(secret_ciphertext) <= 4096))),
    CONSTRAINT source_authorization_attempts_state_hash_check CHECK ((state_hash ~ '^[0-9a-f]{64}$'::text)),
    CONSTRAINT source_authorization_attempts_status_check CHECK ((status = ANY (ARRAY['pending'::text, 'exchanging'::text, 'cancelled'::text])))
);

ALTER TABLE ONLY public.source_authorization_attempts FORCE ROW LEVEL SECURITY;


