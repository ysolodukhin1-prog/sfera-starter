    CONSTRAINT service_connection_policies_allowed_destination_classes_check CHECK ((cardinality(allowed_destination_classes) > 0)),
    CONSTRAINT service_connection_policies_allowed_methods_check CHECK ((cardinality(allowed_methods) > 0)),
    CONSTRAINT service_connection_policies_allowed_methods_check1 CHECK ((allowed_methods <@ ARRAY['GET'::text, 'POST'::text, 'PUT'::text, 'PATCH'::text, 'DELETE'::text])),
    CONSTRAINT service_connection_policies_allowed_path_patterns_check CHECK ((cardinality(allowed_path_patterns) > 0)),
    CONSTRAINT service_connection_policies_allowed_resource_patterns_check CHECK ((cardinality(allowed_resource_patterns) > 0)),
    CONSTRAINT service_connection_policies_revision_check CHECK ((revision > 0)),
    CONSTRAINT service_connection_policies_status_check CHECK ((status = ANY (ARRAY['active'::text, 'disabled'::text, 'revoked'::text])))
);

