    CONSTRAINT cognitive_foundation_sources_publication_year_check CHECK (((publication_year >= 1800) AND (publication_year <= 2200))),
    CONSTRAINT cognitive_foundation_sources_source_type_check CHECK ((source_type = ANY (ARRAY['experiment'::text, 'theory'::text, 'review'::text, 'meta_analysis'::text]))),
    CONSTRAINT cognitive_foundation_sources_status_check CHECK ((status = ANY (ARRAY['active'::text, 'retired'::text])))
);


