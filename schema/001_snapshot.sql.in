);


--
-- Name: tasks; Type: TABLE; Schema: galactica_autonomy; Owner: -
--

CREATE TABLE galactica_autonomy.tasks (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    project_id uuid NOT NULL,
    agent_id text NOT NULL,
    request_text text NOT NULL,
    completion_criteria jsonb DEFAULT '[]'::jsonb NOT NULL,
    status text DEFAULT 'active'::text NOT NULL,
    started_at timestamp with time zone DEFAULT now() NOT NULL,
    finished_at timestamp with time zone,
    summary jsonb,
    summary_sha256 text,
    CONSTRAINT tasks_status_check CHECK ((status = ANY (ARRAY['active'::text, 'succeeded'::text, 'failed'::text, 'partial'::text])))
);


--
-- Name: request_contexts; Type: TABLE; Schema: galactica_security; Owner: -
--

CREATE TABLE galactica_security.request_contexts (
    backend_pid integer NOT NULL,
    transaction_id xid8 NOT NULL,
    credential_id uuid NOT NULL,
    effective_principal_id uuid NOT NULL,
    user_principal_id uuid NOT NULL,
    agent_connection_id uuid,
    account_id uuid NOT NULL,
    project_id uuid NOT NULL,
    requested_action text NOT NULL,
    auth_revision bigint,
    bound_at timestamp with time zone DEFAULT clock_timestamp() NOT NULL,
    expires_at timestamp with time zone NOT NULL,
    CONSTRAINT request_contexts_requested_action_check CHECK ((requested_action = ANY (ARRAY['read'::text, 'write'::text, 'manage'::text, 'publish'::text, 'export'::text, 'execute'::text])))
);


--
-- Name: access_grants; Type: TABLE; Schema: public; Owner: -
--

CREATE TABLE public.access_grants (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    principal_id uuid NOT NULL,
    project_id uuid,
    knowledge_domain_id uuid,
    role text NOT NULL,
    granted_by_principal_id uuid,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL,
    account_id uuid,
    resource_type text,
    resource_id uuid,
    actions text[] DEFAULT '{}'::text[] NOT NULL,
    inheritance text DEFAULT 'restricted'::text NOT NULL,
    status text DEFAULT 'active'::text NOT NULL,
    revision bigint DEFAULT 1 NOT NULL,
    CONSTRAINT access_grants_actions_check CHECK (((actions <@ ARRAY['read'::text, 'write'::text, 'manage'::text, 'publish'::text, 'export'::text, 'execute'::text]) AND (array_position(actions, NULL::text) IS NULL))),
    CONSTRAINT access_grants_active_scope_check CHECK (((status <> 'active'::text) OR ((account_id IS NOT NULL) AND (resource_type IS NOT NULL) AND (resource_id IS NOT NULL) AND (cardinality(actions) > 0)))),
    CONSTRAINT access_grants_check CHECK (((project_id IS NOT NULL) OR (knowledge_domain_id IS NULL))),
    CONSTRAINT access_grants_inheritance_check CHECK ((inheritance = ANY (ARRAY['restricted'::text, 'descendants'::text]))),
    CONSTRAINT access_grants_legacy_scope_match_check CHECK (((status <> 'active'::text) OR ((resource_type = 'project'::text) AND (resource_id = project_id) AND (knowledge_domain_id IS NULL)) OR ((resource_type = 'knowledge_domain'::text) AND (resource_id = knowledge_domain_id) AND (project_id IS NOT NULL)) OR ((resource_type = 'account'::text) AND (resource_id = account_id) AND (project_id IS NULL) AND (knowledge_domain_id IS NULL)))),
    CONSTRAINT access_grants_resource_type_check CHECK (((resource_type IS NULL) OR (resource_type = ANY (ARRAY['account'::text, 'project'::text, 'knowledge_domain'::text])))),
    CONSTRAINT access_grants_role_check CHECK ((role = ANY (ARRAY['reader'::text, 'contributor'::text, 'manager'::text, 'owner'::text]))),
    CONSTRAINT access_grants_status_check CHECK ((status = ANY (ARRAY['active'::text, 'disabled'::text, 'quarantine'::text])))
);


--
-- Name: access_principals; Type: TABLE; Schema: public; Owner: -
--

CREATE TABLE public.access_principals (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    kind text NOT NULL,
    display_name text NOT NULL,
    external_subject text,
    agent_id uuid,
    status text DEFAULT 'active'::text NOT NULL,
    is_superuser boolean DEFAULT false NOT NULL,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL,
    CONSTRAINT access_principals_check CHECK (((kind = 'agent'::text) = (agent_id IS NOT NULL))),
    CONSTRAINT access_principals_kind_check CHECK ((kind = ANY (ARRAY['user'::text, 'agent'::text, 'service'::text]))),
    CONSTRAINT access_principals_status_check CHECK ((status = ANY (ARRAY['active'::text, 'disabled'::text])))
);


--
-- Name: account_memberships; Type: TABLE; Schema: public; Owner: -
--

CREATE TABLE public.account_memberships (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    account_id uuid NOT NULL,
    principal_id uuid NOT NULL,
    role text NOT NULL,
    status text DEFAULT 'active'::text NOT NULL,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL,
    CONSTRAINT account_memberships_role_check CHECK ((role = ANY (ARRAY['reader'::text, 'contributor'::text, 'manager'::text, 'owner'::text]))),
