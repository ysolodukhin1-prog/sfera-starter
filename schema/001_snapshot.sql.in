CREATE FUNCTION public.reject_derived_privacy_rebind() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
        BEGIN
          IF NEW.owner_principal_id IS DISTINCT FROM OLD.owner_principal_id OR
             NEW.privacy_lineage IS DISTINCT FROM OLD.privacy_lineage OR
             NEW.visibility_scope IS DISTINCT FROM OLD.visibility_scope THEN
            RAISE EXCEPTION '% privacy lineage is immutable', TG_TABLE_NAME;
          END IF;
          RETURN NEW;
        END $$;


