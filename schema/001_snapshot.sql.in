    CONSTRAINT expert_profiles_check CHECK (((profile_type = 'candidate'::text) OR (lifecycle_state <> 'probation'::text))),
    CONSTRAINT expert_profiles_check1 CHECK (((profile_type = 'candidate'::text) OR (probation_expires_at IS NULL))),
    CONSTRAINT expert_profiles_display_name_check CHECK ((length(btrim(display_name)) > 0)),
    CONSTRAINT expert_profiles_does_not_own_check CHECK (((jsonb_typeof(does_not_own) = 'array'::text) AND (NOT public.runtime_jsonb_has_forbidden_run_key(does_not_own)))),
    CONSTRAINT expert_profiles_lifecycle_state_check CHECK ((lifecycle_state = ANY (ARRAY['planned'::text, 'probation'::text, 'active'::text, 'remediation'::text, 'restricted'::text, 'dormant'::text, 'merged'::text, 'retired'::text]))),
    CONSTRAINT expert_profiles_mission_check CHECK ((length(btrim(mission)) > 0)),
    CONSTRAINT expert_profiles_organization_group_check CHECK ((length(btrim(organization_group)) > 0)),
    CONSTRAINT expert_profiles_owns_check CHECK (((jsonb_typeof(owns) = 'array'::text) AND (NOT public.runtime_jsonb_has_forbidden_run_key(owns)))),
    CONSTRAINT expert_profiles_profile_type_check CHECK ((profile_type = ANY (ARRAY['permanent'::text, 'candidate'::text]))),
    CONSTRAINT expert_profiles_stable_key_check CHECK ((stable_key ~ '^[a-z][a-z0-9_]*(\.[a-z][a-z0-9_]*)+$'::text))
);


