    CONSTRAINT acl_rules_effect_check CHECK ((effect = ANY (ARRAY['allow'::text, 'deny'::text]))),
    CONSTRAINT acl_rules_scope_kind_check CHECK ((scope_kind = ANY (ARRAY['root'::text, 'section'::text, 'material'::text]))),
    CONSTRAINT acl_rules_subject_kind_check CHECK ((subject_kind = ANY (ARRAY['everyone'::text, 'user'::text, 'group'::text])))
);


