    evidence_message_ids text[] DEFAULT '{}'::text[] NOT NULL,
    status text DEFAULT 'active'::text NOT NULL,
    verification_status text DEFAULT 'curated'::text NOT NULL,
    CONSTRAINT relations_status_check CHECK ((status = ANY (ARRAY['active'::text, 'review'::text, 'superseded'::text]))),
    CONSTRAINT relations_verification_status_check CHECK ((verification_status = ANY (ARRAY['curated'::text, 'source_backed'::text, 'model_proposed'::text])))
);


