    CONSTRAINT cognitive_foundation_items_item_type_check CHECK ((item_type = ANY (ARRAY['claim'::text, 'mechanism'::text, 'engineering_pattern'::text]))),
    CONSTRAINT cognitive_foundation_items_status_check CHECK ((status = ANY (ARRAY['active'::text, 'superseded'::text, 'retired'::text])))
);


