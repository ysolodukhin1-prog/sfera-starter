--
-- Name: goals; Type: TABLE; Schema: public; Owner: -
--

CREATE TABLE public.goals (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    project_id uuid NOT NULL,
    scope text NOT NULL,
    owner text NOT NULL,
    owner_agent_id uuid,
    parent_goal_id uuid,
    stable_key text NOT NULL,
    title text NOT NULL,
    desired_state text NOT NULL,
    priority smallint DEFAULT 50 NOT NULL,
    horizon text DEFAULT 'ongoing'::text NOT NULL,
    status text DEFAULT 'active'::text NOT NULL,
    constraints jsonb DEFAULT '[]'::jsonb NOT NULL,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL,
    cadence text,
    starts_at timestamp with time zone,
    due_at timestamp with time zone,
    completed_at timestamp with time zone,
    confirmation_status text DEFAULT 'not_required'::text NOT NULL,
    confirmed_at timestamp with time zone,
    review jsonb DEFAULT '{}'::jsonb NOT NULL,
    account_id uuid NOT NULL,
    visibility_scope text NOT NULL,
    CONSTRAINT goals_cadence_check CHECK (((cadence IS NULL) OR (cadence = ANY (ARRAY['annual'::text, 'monthly'::text, 'weekly'::text, 'daily'::text])))),
    CONSTRAINT goals_cadence_due_check CHECK (((cadence IS NULL) OR (due_at IS NOT NULL))),
    CONSTRAINT goals_check CHECK (((parent_goal_id IS NULL) OR (parent_goal_id <> id))),
    CONSTRAINT goals_confirmation_status_check CHECK ((confirmation_status = ANY (ARRAY['not_required'::text, 'pending'::text, 'approved'::text, 'rejected'::text]))),
    CONSTRAINT goals_constraints_check CHECK ((jsonb_typeof(constraints) = 'array'::text)),
    CONSTRAINT goals_desired_state_check CHECK ((length(btrim(desired_state)) > 0)),
    CONSTRAINT goals_horizon_check CHECK ((horizon = ANY (ARRAY['immediate'::text, 'short_term'::text, 'medium_term'::text, 'long_term'::text, 'ongoing'::text]))),
    CONSTRAINT goals_owner_check CHECK ((owner = ANY (ARRAY['human'::text, 'agent'::text, 'codex'::text, 'shared'::text]))),
    CONSTRAINT goals_pending_proposal_check CHECK (((confirmation_status <> 'pending'::text) OR (status = 'draft'::text))),
    CONSTRAINT goals_planning_window_check CHECK (((starts_at IS NULL) OR (due_at IS NULL) OR (due_at > starts_at))),
    CONSTRAINT goals_priority_check CHECK (((priority >= 0) AND (priority <= 100))),
    CONSTRAINT goals_review_object_check CHECK (((jsonb_typeof(review) = 'object'::text) AND (NOT public.runtime_jsonb_has_forbidden_run_key(review)))),
    CONSTRAINT goals_scope_check CHECK ((scope = ANY (ARRAY['global'::text, 'project'::text, 'task'::text]))),
    CONSTRAINT goals_stable_key_check CHECK (((length(stable_key) >= 8) AND (length(stable_key) <= 300))),
    CONSTRAINT goals_status_check CHECK ((status = ANY (ARRAY['draft'::text, 'active'::text, 'paused'::text, 'achieved'::text, 'abandoned'::text]))),
    CONSTRAINT goals_title_check CHECK ((length(btrim(title)) > 0)),
    CONSTRAINT goals_visibility_scope_check CHECK ((visibility_scope = ANY (ARRAY['commons'::text, 'account'::text, 'private'::text, 'quarantine'::text])))
);

