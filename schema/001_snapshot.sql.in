-- Name: acquire_service_delivery_fence(); Type: FUNCTION; Schema: galactica_security; Owner: -
--

CREATE FUNCTION galactica_security.acquire_service_delivery_fence() RETURNS void
    LANGUAGE sql SECURITY DEFINER
    SET search_path TO 'pg_catalog'
    AS $$
          SELECT pg_catalog.pg_advisory_xact_lock_shared(17491,59)
        $$;


--
-- Name: action_covers(text, text); Type: FUNCTION; Schema: galactica_security; Owner: -
--

CREATE FUNCTION galactica_security.action_covers(bound_action text, required_action text) RETURNS boolean
    LANGUAGE sql IMMUTABLE PARALLEL SAFE
    AS $$
          SELECT CASE bound_action
            WHEN 'manage' THEN required_action IN ('read','write','manage')
            WHEN 'write' THEN required_action IN ('read','write')
            ELSE bound_action = required_action
          END
        $$;


--
-- Name: audit_service_permission(); Type: FUNCTION; Schema: galactica_security; Owner: -
--

CREATE FUNCTION galactica_security.audit_service_permission() RETURNS trigger
    LANGUAGE plpgsql
    SET search_path TO 'pg_catalog', 'public'
    AS $$
        BEGIN
          INSERT INTO service_permission_events(
            entity_type,entity_id,actor_id,before_state,after_state)
          VALUES (TG_TABLE_NAME,NEW.id,NEW.updated_by,
            CASE WHEN TG_OP='UPDATE' THEN to_jsonb(OLD) ELSE NULL END,to_jsonb(NEW));
          RETURN NEW;
        END $$;


--
-- Name: bind_request_context(text, uuid, text); Type: FUNCTION; Schema: galactica_security; Owner: -
--

CREATE FUNCTION galactica_security.bind_request_context(credential_token text, requested_project_id uuid, requested_action text) RETURNS TABLE(user_principal_id uuid, effective_principal_id uuid, account_id uuid, project_id uuid, agent_connection_id uuid, expires_at timestamp with time zone)
    LANGUAGE plpgsql SECURITY DEFINER
    SET search_path TO 'pg_catalog', 'public', 'galactica_security'
    AS $$
        DECLARE
          credential_row record;
          connection_row record;
          project_account uuid;
          resolved_user uuid;
          resolved_connection uuid;
          resolved_revision bigint;
          context_expiry timestamptz;
          current_tx xid8;
        BEGIN
          IF credential_token IS NULL OR length(credential_token) < 32
             OR length(credential_token) > 512 THEN
            RAISE EXCEPTION 'invalid database delegation credential'
              USING ERRCODE = '28000';
          END IF;
          IF requested_project_id IS NULL OR requested_action NOT IN
             ('read','write','manage','publish','export','execute') THEN
            RAISE EXCEPTION 'invalid database delegation scope'
              USING ERRCODE = '28000';
          END IF;

          SELECT c.id, c.principal_id, c.kind, c.expires_at
          INTO credential_row
          FROM public.auth_credentials c
          JOIN public.access_principals p ON p.id = c.principal_id
            WHERE c.token_hash = encode(
              public.digest(pg_catalog.convert_to(credential_token, 'UTF8'), 'sha256'),
              'hex'
            )
            AND c.revoked_at IS NULL AND c.expires_at > clock_timestamp()
            AND p.status = 'active';
          IF credential_row.id IS NULL THEN
            RAISE EXCEPTION 'invalid or revoked database delegation credential'
              USING ERRCODE = '28000';
          END IF;

          SELECT p.account_id INTO project_account
          FROM public.projects p WHERE p.id = requested_project_id;
          IF project_account IS NULL THEN
            RAISE EXCEPTION 'unknown database delegation project'
              USING ERRCODE = '28000';
          END IF;

          IF credential_row.kind = 'browser' THEN
            SELECT p.id INTO resolved_user
            FROM public.access_principals p
            WHERE p.id = credential_row.principal_id AND p.kind = 'user';
          ELSIF credential_row.kind = 'agent' THEN
            SELECT ac.id, ac.user_principal_id, ac.auth_revision
            INTO resolved_connection, resolved_user, resolved_revision
            FROM public.agent_connections ac
            JOIN public.access_principals user_p
              ON user_p.id = ac.user_principal_id AND user_p.kind = 'user'
                 AND user_p.status = 'active'
            WHERE ac.credential_id = credential_row.id
              AND ac.agent_principal_id = credential_row.principal_id
              AND ac.account_id = project_account
              AND ac.project_id = requested_project_id
              AND ac.status = 'active' AND ac.expires_at > clock_timestamp()
              AND requested_action = ANY(ac.allowed_actions);
          END IF;
          IF resolved_user IS NULL THEN
            RAISE EXCEPTION 'credential is not bound to an active user'
              USING ERRCODE = '28000';
          END IF;

          IF NOT EXISTS (
            SELECT 1 FROM public.account_memberships m
            WHERE m.principal_id = resolved_user AND m.account_id = project_account
              AND m.status = 'active'
          ) OR NOT EXISTS (
            SELECT 1 FROM public.access_grants g
            WHERE g.principal_id = resolved_user AND g.account_id = project_account
              AND g.status = 'active' AND requested_action = ANY(g.actions)
              AND (
                (g.resource_type = 'account' AND g.resource_id = project_account)
                OR g.project_id = requested_project_id
              )
          ) THEN
            RAISE EXCEPTION 'database delegation is outside current user permissions'
              USING ERRCODE = '42501';
          END IF;

          current_tx := pg_current_xact_id();
          context_expiry := least(
            credential_row.expires_at,
            clock_timestamp() + interval '5 minutes'
          );
          DELETE FROM galactica_security.request_contexts old_ctx
            WHERE old_ctx.expires_at <= clock_timestamp()
               OR (old_ctx.backend_pid = pg_backend_pid()
                   AND old_ctx.transaction_id <> current_tx);
          INSERT INTO galactica_security.request_contexts(
            backend_pid, transaction_id, credential_id, effective_principal_id,
            user_principal_id, agent_connection_id, account_id, project_id,
            requested_action, auth_revision, expires_at
          ) VALUES (
            pg_backend_pid(), current_tx, credential_row.id,
            credential_row.principal_id, resolved_user, resolved_connection,
            project_account, requested_project_id, requested_action,
            resolved_revision, context_expiry
          )
          ON CONFLICT (backend_pid, transaction_id) DO UPDATE SET
            credential_id = EXCLUDED.credential_id,
            effective_principal_id = EXCLUDED.effective_principal_id,
            user_principal_id = EXCLUDED.user_principal_id,
            agent_connection_id = EXCLUDED.agent_connection_id,
            account_id = EXCLUDED.account_id,
            project_id = EXCLUDED.project_id,
            requested_action = EXCLUDED.requested_action,
            auth_revision = EXCLUDED.auth_revision,
            bound_at = clock_timestamp(),
            expires_at = EXCLUDED.expires_at;

          RETURN QUERY SELECT resolved_user, credential_row.principal_id,
            project_account, requested_project_id, resolved_connection, context_expiry;
        END
        $$;


--
-- Name: bind_source_identity_owner(); Type: FUNCTION; Schema: galactica_security; Owner: -
--

CREATE FUNCTION galactica_security.bind_source_identity_owner() RETURNS trigger
    LANGUAGE plpgsql SECURITY DEFINER
    SET search_path TO 'pg_catalog'
    AS $$
        DECLARE existing_owner uuid;
        BEGIN
          IF TG_OP='UPDATE' AND
             (NEW.user_principal_id,NEW.account_id,NEW.service_key) IS DISTINCT FROM
             (OLD.user_principal_id,OLD.account_id,OLD.service_key) THEN
            RAISE EXCEPTION 'source link owner and account are immutable' USING ERRCODE='42501';
          END IF;
          SELECT user_principal_id INTO existing_owner FROM public.source_identity_owners
            WHERE service_key=NEW.service_key AND source_subject_key=NEW.source_subject_key;
          IF NOT FOUND THEN
            IF NEW.status<>'verified' OR NEW.verified_at IS NULL THEN
              RAISE EXCEPTION 'first source binding requires verified source proof'
                USING ERRCODE='42501';
            END IF;
            INSERT INTO public.source_identity_owners
              (service_key,source_subject_key,user_principal_id)
              VALUES(NEW.service_key,NEW.source_subject_key,NEW.user_principal_id)
              ON CONFLICT(service_key,source_subject_key) DO NOTHING;
            SELECT user_principal_id INTO existing_owner FROM public.source_identity_owners
              WHERE service_key=NEW.service_key AND source_subject_key=NEW.source_subject_key;
          END IF;
          IF existing_owner IS DISTINCT FROM NEW.user_principal_id THEN
            RAISE EXCEPTION 'source identity belongs to another owner' USING ERRCODE='42501';
          END IF;
          RETURN NEW;
        END $$;


--
-- Name: check_service_assignment(text, text, text, uuid, text); Type: FUNCTION; Schema: galactica_security; Owner: -
--

CREATE FUNCTION galactica_security.check_service_assignment(credential_token text, credential_kind text, requested_service text, requested_project uuid, requested_action text) RETURNS TABLE(principal_id uuid, credential_id uuid, agent_connection_id uuid, account_id uuid, project_id uuid, service_key text, action text, grant_id uuid, grant_revision bigint, service_revision bigint, auth_revision bigint)
    LANGUAGE plpgsql SECURITY DEFINER
    SET search_path TO 'pg_catalog'
    AS $$
        BEGIN
          IF credential_token IS NULL OR length(credential_token) NOT BETWEEN 32 AND 256
            OR credential_kind IS NULL OR credential_kind NOT IN ('browser','agent')
            OR requested_service IS NULL OR length(requested_service) NOT BETWEEN 1 AND 120
            OR requested_project IS NULL OR requested_action IS NULL
            OR requested_action NOT IN ('read','write','manage','publish','export','execute')
          THEN
            RAISE EXCEPTION 'service access denied' USING ERRCODE='42501';
          END IF;
          RETURN QUERY
          SELECT u.id,c.id,ac.id,a.id,p.id,s.service_key,requested_action,
            g.id,g.revision,s.definition_revision,coalesce(ac.auth_revision,1::bigint)
          FROM public.auth_credentials c
          JOIN public.access_principals owner ON owner.id=c.principal_id
          LEFT JOIN public.agent_connections ac ON c.kind='agent' AND ac.credential_id=c.id
          JOIN public.access_principals u ON u.id=CASE
            WHEN c.kind='browser' THEN c.principal_id ELSE ac.user_principal_id END
          JOIN public.service_access_grants g ON g.principal_id=u.id
          JOIN public.service_catalog s ON s.service_key=g.service_key
          JOIN public.accounts a ON a.id=g.account_id
          JOIN public.projects p ON p.id=requested_project AND p.account_id=a.id
          WHERE c.token_hash=encode(public.digest(convert_to(credential_token,'UTF8'),'sha256'),'hex')
            AND c.kind=credential_kind AND c.revoked_at IS NULL AND c.expires_at>clock_timestamp()
            AND owner.status='active' AND u.kind='user' AND u.status='active'
            AND (owner.agent_id IS NULL OR EXISTS (
              SELECT 1 FROM public.agents agent WHERE agent.id=owner.agent_id AND agent.status='active'))
            AND (c.kind='browser' OR (
              ac.agent_principal_id=c.principal_id AND ac.status='active'
              AND ac.revoked_at IS NULL AND ac.expires_at>clock_timestamp()
              AND ac.account_id=a.id AND (ac.project_id IS NULL OR ac.project_id=p.id)
              AND requested_action=ANY(ac.allowed_actions)))
            AND a.status='active' AND p.visibility_scope<>'quarantine'
            AND s.service_key=requested_service AND s.status='active'
            AND requested_action=ANY(s.allowed_actions)
            AND g.status='active' AND requested_action=ANY(g.actions)
            AND ((g.scope_kind='account' AND g.project_id IS NULL)
              OR (g.scope_kind='project' AND g.project_id=p.id))
          ORDER BY g.scope_kind,g.id LIMIT 1;
          IF NOT FOUND THEN
            RAISE EXCEPTION 'service access denied' USING ERRCODE='42501';
          END IF;
        END $$;


--
-- Name: current_user_principal_id(); Type: FUNCTION; Schema: galactica_security; Owner: -
--

CREATE FUNCTION galactica_security.current_user_principal_id() RETURNS uuid
    LANGUAGE sql STABLE SECURITY DEFINER
    SET search_path TO 'pg_catalog', 'galactica_security'
    AS $$
          SELECT ctx.user_principal_id FROM request_contexts ctx
          WHERE ctx.backend_pid=pg_backend_pid()
            AND ctx.transaction_id=pg_current_xact_id()
            AND ctx.expires_at>clock_timestamp()
        $$;


--
-- Name: enforce_relation_privacy_scope(); Type: FUNCTION; Schema: galactica_security; Owner: -
--

CREATE FUNCTION galactica_security.enforce_relation_privacy_scope() RETURNS trigger
    LANGUAGE plpgsql SECURITY DEFINER
    SET search_path TO 'pg_catalog', 'public', 'galactica_security'
    AS $$
        DECLARE source_scope record; target_scope record; relation_domain uuid;
        BEGIN
          IF TG_TABLE_NAME='knowledge_relations' THEN
            SELECT account_id,project_id,knowledge_domain_id,owner_principal_id,
                   visibility_scope,NULL::text AS layer INTO source_scope
            FROM public.knowledge_items WHERE id=NEW.source_item_id;
            SELECT account_id,project_id,knowledge_domain_id,owner_principal_id,
                   visibility_scope,NULL::text AS layer INTO target_scope
            FROM public.knowledge_items WHERE id=NEW.target_item_id;
          ELSE
            SELECT account_id,project_id,knowledge_domain_id,owner_principal_id,
                   visibility_scope,layer INTO source_scope
            FROM public.semantic_nodes WHERE id=NEW.source_node_id;
            SELECT account_id,project_id,knowledge_domain_id,owner_principal_id,
                   visibility_scope,layer INTO target_scope
            FROM public.semantic_nodes WHERE id=NEW.target_node_id;
          END IF;
          IF source_scope IS NULL OR target_scope IS NULL THEN
            RAISE EXCEPTION 'relation endpoint is missing';
          END IF;
          IF source_scope.account_id<>target_scope.account_id
             OR source_scope.project_id<>target_scope.project_id
             OR (source_scope.visibility_scope='private' AND
                 target_scope.layer<>'project' AND
                 source_scope.owner_principal_id<>target_scope.owner_principal_id)
             OR (source_scope.visibility_scope<>target_scope.visibility_scope AND
                 NOT (TG_TABLE_NAME='semantic_relations' AND
                      target_scope.layer='project'))
             OR source_scope.visibility_scope='quarantine' THEN
            RAISE EXCEPTION 'relation endpoints have different privacy scopes';
          END IF;
          IF source_scope.knowledge_domain_id IS NOT DISTINCT FROM
             target_scope.knowledge_domain_id THEN
            relation_domain:=source_scope.knowledge_domain_id;
          ELSIF TG_TABLE_NAME='semantic_relations'
             AND source_scope.knowledge_domain_id IS NULL
             AND source_scope.layer IN ('self','memory','project') THEN
            relation_domain:=target_scope.knowledge_domain_id;
          ELSIF TG_TABLE_NAME='semantic_relations'
             AND target_scope.layer='project' THEN
            relation_domain:=source_scope.knowledge_domain_id;
          ELSE
            RAISE EXCEPTION 'relation endpoints have different domain scopes';
          END IF;
          IF NEW.account_id<>source_scope.account_id
             OR NEW.project_id<>source_scope.project_id
             OR (NEW.owner_principal_id IS NOT NULL AND
                 NEW.owner_principal_id<>source_scope.owner_principal_id)
             OR (NEW.knowledge_domain_id IS NOT NULL AND
                 NEW.knowledge_domain_id IS DISTINCT FROM
                 relation_domain) THEN
            RAISE EXCEPTION 'relation privacy scope differs from endpoints';
          END IF;
          NEW.owner_principal_id:=source_scope.owner_principal_id;
          NEW.knowledge_domain_id:=relation_domain;
          NEW.visibility_scope:=source_scope.visibility_scope;
          IF TG_TABLE_NAME='knowledge_relations' THEN
            NEW.privacy_lineage:=jsonb_build_object(
              'schema_version','1.0','stage',TG_TABLE_NAME,
              'owner_principal_id',source_scope.owner_principal_id::text,
              'source_id',NEW.source_item_id::text,
              'target_id',NEW.target_item_id::text);
          ELSE
            NEW.privacy_lineage:=jsonb_build_object(
              'schema_version','1.0','stage',TG_TABLE_NAME,
              'owner_principal_id',source_scope.owner_principal_id::text,
              'source_id',NEW.source_node_id::text,
              'target_id',NEW.target_node_id::text);
          END IF;
          RETURN NEW;
        END $$;


--
-- Name: fence_service_authority_mutation(); Type: FUNCTION; Schema: galactica_security; Owner: -
--

CREATE FUNCTION galactica_security.fence_service_authority_mutation() RETURNS trigger
    LANGUAGE plpgsql SECURITY DEFINER
    SET search_path TO 'pg_catalog'
    AS $$
        BEGIN
          IF pg_catalog.current_setting('transaction_isolation') <> 'read committed' THEN
            RAISE EXCEPTION 'authority changes require a fresh READ COMMITTED transaction'
              USING ERRCODE='25001';
          END IF;
          PERFORM pg_catalog.pg_advisory_xact_lock(17491,59);
          IF EXISTS (SELECT 1 FROM public.service_delivery_permits WHERE completed_at IS NULL) THEN
            RAISE EXCEPTION 'service delivery unresolved; authority change not committed'
              USING ERRCODE='55006';
          END IF;
          RETURN NULL;
        END $$;


--
-- Name: guard_publication_state_update(); Type: FUNCTION; Schema: galactica_security; Owner: -
--

CREATE FUNCTION galactica_security.guard_publication_state_update() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
        BEGIN
          IF TG_TABLE_NAME='publication_requests' AND
             (to_jsonb(NEW)-ARRAY['status','updated_at']) IS DISTINCT FROM
             (to_jsonb(OLD)-ARRAY['status','updated_at']) THEN
            RAISE EXCEPTION 'publication request scope is immutable';
          ELSIF TG_TABLE_NAME='publication_approvals' AND
             (to_jsonb(NEW)-ARRAY['status','revoked_at']) IS DISTINCT FROM
             (to_jsonb(OLD)-ARRAY['status','revoked_at']) THEN
            RAISE EXCEPTION 'publication approval evidence is immutable';
          ELSIF TG_TABLE_NAME='publication_manifests' AND
             (to_jsonb(NEW)-ARRAY['status','revoked_at']) IS DISTINCT FROM
             (to_jsonb(OLD)-ARRAY['status','revoked_at']) THEN
            RAISE EXCEPTION 'published manifest is immutable';
          ELSIF TG_TABLE_NAME='managed_files' AND
             (to_jsonb(NEW)-ARRAY['status','updated_at']) IS DISTINCT FROM
             (to_jsonb(OLD)-ARRAY['status','updated_at']) THEN
            RAISE EXCEPTION 'managed file scope and locator are immutable';
          END IF;
          RETURN NEW;
        END;
        $$;


--
-- Name: guard_published_staging_cancel(); Type: FUNCTION; Schema: galactica_security; Owner: -
--

CREATE FUNCTION galactica_security.guard_published_staging_cancel() RETURNS trigger
    LANGUAGE plpgsql
    SET search_path TO 'pg_catalog'
    AS $$
      BEGIN
        IF NEW.cancelled_at IS NOT NULL AND EXISTS (
          SELECT 1 FROM public.source_provisioning_requests p
            WHERE p.id=NEW.request_id AND p.status='active') THEN
          RAISE EXCEPTION 'published source requires revocation' USING ERRCODE='42501';
        END IF;
        RETURN NEW;
      END $$;


--
-- Name: guard_service_permission(); Type: FUNCTION; Schema: galactica_security; Owner: -
--

CREATE FUNCTION galactica_security.guard_service_permission() RETURNS trigger
    LANGUAGE plpgsql
    SET search_path TO 'pg_catalog', 'public'
    AS $$
        DECLARE subject_kind text; catalog_actions text[];
        BEGIN
          SELECT kind INTO subject_kind FROM access_principals WHERE id=NEW.principal_id;
          IF subject_kind IS DISTINCT FROM 'user' THEN
            RAISE EXCEPTION 'service rights require a human principal';
          END IF;
          SELECT allowed_actions INTO catalog_actions FROM service_catalog
            WHERE service_key=NEW.service_key;
          IF TG_OP='UPDATE' AND NEW.status='revoked' AND NEW.actions=OLD.actions THEN
            -- Retiring a service action cannot prevent revocation of its old grants.
            NULL;
          ELSIF catalog_actions IS NULL OR NOT NEW.actions <@ catalog_actions THEN
            RAISE EXCEPTION 'actions exceed service definition';
          END IF;
          IF TG_OP='UPDATE' THEN
            IF (NEW.id,NEW.principal_id,NEW.service_key,NEW.account_id,NEW.scope_kind,
                NEW.project_id,NEW.created_by,NEW.created_at) IS DISTINCT FROM
               (OLD.id,OLD.principal_id,OLD.service_key,OLD.account_id,OLD.scope_kind,
                OLD.project_id,OLD.created_by,OLD.created_at) THEN
              RAISE EXCEPTION 'service permission identity is immutable';
            END IF;
            IF TG_TABLE_NAME='service_administration_scopes' AND
               to_jsonb(NEW)->'parent_scope_id' IS DISTINCT FROM
               to_jsonb(OLD)->'parent_scope_id' THEN
              RAISE EXCEPTION 'administration parent is immutable';
            END IF;
            IF NEW.revision<>OLD.revision+1 THEN
              RAISE EXCEPTION 'service permission revision must advance by one';
            END IF;
            NEW.updated_at=clock_timestamp();
          ELSIF NEW.revision<>1 THEN
            RAISE EXCEPTION 'new service permission starts at revision one';
          END IF;
          RETURN NEW;
        END $$;


--
-- Name: guard_source_authorization_attempt(); Type: FUNCTION; Schema: galactica_security; Owner: -
--

CREATE FUNCTION galactica_security.guard_source_authorization_attempt() RETURNS trigger
    LANGUAGE plpgsql
    SET search_path TO 'pg_catalog'
    AS $$
      BEGIN
        IF TG_OP IN ('DELETE','TRUNCATE') THEN
          RAISE EXCEPTION 'source authorization history is retained' USING ERRCODE='42501';
        END IF;
        IF (to_jsonb(NEW)-'status'-'code_hash'-'changed_at') IS DISTINCT FROM
           (to_jsonb(OLD)-'status'-'code_hash'-'changed_at')
          OR OLD.status<>'pending' OR NEW.status NOT IN ('exchanging','cancelled')
          OR (NEW.status='exchanging' AND OLD.expires_at<=clock_timestamp()) THEN
          RAISE EXCEPTION 'invalid authorization attempt transition' USING ERRCODE='42501';
        END IF;
        NEW.changed_at:=clock_timestamp();
        RETURN NEW;
      END $$;


--
-- Name: guard_source_exchange_staging(); Type: FUNCTION; Schema: galactica_security; Owner: -
--

CREATE FUNCTION galactica_security.guard_source_exchange_staging() RETURNS trigger
    LANGUAGE plpgsql
    SET search_path TO 'pg_catalog'
    AS $$
      BEGIN
        IF TG_OP IN ('DELETE','TRUNCATE') THEN
          RAISE EXCEPTION 'source staging history retained' USING ERRCODE='42501';
        ELSIF TG_OP='INSERT' THEN
          IF NEW.cancelled_at IS NOT NULL OR NOT EXISTS (
            SELECT 1 FROM public.source_authorization_attempts a
              WHERE a.id=NEW.request_id AND a.status='exchanging'
                AND a.expires_at>clock_timestamp() AND NEW.expires_at<=a.expires_at
          ) OR NEW.expires_at<=clock_timestamp() THEN
            RAISE EXCEPTION 'invalid source staging attempt' USING ERRCODE='42501';
          END IF;
        ELSIF (to_jsonb(NEW)-'cancelled_at') IS DISTINCT FROM
              (to_jsonb(OLD)-'cancelled_at')
          OR OLD.cancelled_at IS NOT NULL OR NEW.cancelled_at IS NULL THEN
          RAISE EXCEPTION 'immutable source staging' USING ERRCODE='42501';
        ELSE
          NEW.cancelled_at:=clock_timestamp();
        END IF;
        RETURN NEW;
      END $$;


--
-- Name: guard_source_provisioning(); Type: FUNCTION; Schema: galactica_security; Owner: -
--

CREATE FUNCTION galactica_security.guard_source_provisioning() RETURNS trigger
    LANGUAGE plpgsql
    SET search_path TO 'pg_catalog'
    AS $$
        BEGIN
          IF TG_OP IN ('DELETE','TRUNCATE') THEN
            RAISE EXCEPTION 'source provisioning history is retained' USING ERRCODE='42501';
          END IF;
          IF TG_TABLE_NAME='source_service_instances' THEN
            IF (to_jsonb(NEW)-'status') IS DISTINCT FROM (to_jsonb(OLD)-'status') THEN
              RAISE EXCEPTION 'source instance binding is immutable' USING ERRCODE='42501';
            END IF;
          ELSE
            IF (to_jsonb(NEW)-'status'-'finished_at') IS DISTINCT FROM
               (to_jsonb(OLD)-'status'-'finished_at')
               OR OLD.status<>'pending' OR NEW.status NOT IN ('active','cancelled') THEN
              RAISE EXCEPTION 'invalid source provisioning transition' USING ERRCODE='42501';
            END IF;
            IF NEW.status='active' AND
               (OLD.expires_at<=clock_timestamp() OR OLD.session_expires_at<=clock_timestamp()) THEN
              RAISE EXCEPTION 'source provisioning expired' USING ERRCODE='42501';
            END IF;
            NEW.finished_at:=clock_timestamp();
          END IF;
          RETURN NEW;
        END $$;


--
-- Name: guard_staged_confirmation(); Type: FUNCTION; Schema: galactica_security; Owner: -
--

CREATE FUNCTION galactica_security.guard_staged_confirmation() RETURNS trigger
    LANGUAGE plpgsql
    SET search_path TO 'pg_catalog'
    AS $$
      BEGIN
        IF TG_OP<>'INSERT' THEN
          RAISE EXCEPTION 'confirmation history retained' USING ERRCODE='42501';
        END IF;
        IF NOT EXISTS (SELECT 1 FROM public.source_exchange_staging s
          WHERE s.request_id=NEW.request_id AND s.source_subject_key=NEW.source_subject_key
            AND s.cancelled_at IS NULL AND s.expires_at>clock_timestamp()) THEN
          RAISE EXCEPTION 'source staging not confirmable' USING ERRCODE='42501';
        END IF;
        RETURN NEW;
      END $$;


--
-- Name: guard_staged_publication(); Type: FUNCTION; Schema: galactica_security; Owner: -
--

CREATE FUNCTION galactica_security.guard_staged_publication() RETURNS trigger
    LANGUAGE plpgsql
    SET search_path TO 'pg_catalog'
    AS $$
      BEGIN
        IF EXISTS (SELECT 1 FROM public.source_authorization_attempts WHERE id=NEW.id)
          AND NEW.status IN ('pending','active') AND NOT EXISTS (
          SELECT 1 FROM public.source_authorization_attempts a
            JOIN public.source_exchange_staging s ON s.request_id=a.id
            JOIN public.source_staging_confirmations c ON c.request_id=s.request_id
          WHERE a.id=NEW.id AND a.status='exchanging'
            AND (a.principal_id,a.credential_id,a.account_id,a.service_key,a.instance_id,a.origin)
              =(NEW.principal_id,NEW.credential_id,NEW.account_id,NEW.service_key,
                NEW.instance_id,NEW.origin)
            AND (s.source_subject_key,s.source_user_revision,s.session_expires_at)
              =(NEW.source_subject_key,NEW.source_user_revision,NEW.session_expires_at)
            AND c.source_subject_key=s.source_subject_key
            AND s.cancelled_at IS NULL AND s.expires_at>clock_timestamp()
        ) THEN
          RAISE EXCEPTION 'staged publication denied' USING ERRCODE='42501';
        END IF;
        RETURN NEW;
      END $$;


--
-- Name: guard_staged_publication_digest(); Type: FUNCTION; Schema: galactica_security; Owner: -
--

CREATE FUNCTION galactica_security.guard_staged_publication_digest() RETURNS trigger
    LANGUAGE plpgsql
    SET search_path TO 'pg_catalog'
    AS $$
      BEGIN
        IF NEW.status IN ('pending','active') AND EXISTS (
          SELECT 1 FROM public.source_authorization_attempts a WHERE a.id=NEW.id
        ) AND NOT EXISTS (
          SELECT 1 FROM public.source_exchange_staging s
            WHERE s.request_id=NEW.id AND s.credential_digest=NEW.session_digest
        ) THEN
          RAISE EXCEPTION 'staged credential mismatch' USING ERRCODE='42501';
        END IF;
        RETURN NEW;
      END $$;


--
-- Name: guard_staging_digest(); Type: FUNCTION; Schema: galactica_security; Owner: -
--

CREATE FUNCTION galactica_security.guard_staging_digest() RETURNS trigger
    LANGUAGE plpgsql
    SET search_path TO 'pg_catalog'
    AS $$
      BEGIN
        IF NEW.credential_digest IS NULL THEN
          RAISE EXCEPTION 'staged credential digest required' USING ERRCODE='42501';
        END IF;
        RETURN NEW;
      END $$;


--
-- Name: policy_account_visible(uuid); Type: FUNCTION; Schema: galactica_security; Owner: -
--

CREATE FUNCTION galactica_security.policy_account_visible(row_account_id uuid) RETURNS boolean
    LANGUAGE sql STABLE SECURITY DEFINER PARALLEL RESTRICTED
    SET search_path TO 'pg_catalog', 'public', 'galactica_security'
    AS $$
          SELECT EXISTS (
            SELECT 1
            FROM galactica_security.request_contexts ctx
            JOIN public.auth_credentials c
              ON c.id = ctx.credential_id
             AND c.revoked_at IS NULL
             AND c.expires_at > clock_timestamp()
            JOIN public.access_principals p
              ON p.id = ctx.effective_principal_id AND p.status = 'active'
            WHERE ctx.backend_pid = pg_backend_pid()
              AND ctx.transaction_id = pg_current_xact_id()
              AND ctx.expires_at > clock_timestamp()
              AND (row_account_id IS NULL OR row_account_id = ctx.account_id)
          )
        $$;


--
-- Name: preserve_source_identity_owner(); Type: FUNCTION; Schema: galactica_security; Owner: -
--

CREATE FUNCTION galactica_security.preserve_source_identity_owner() RETURNS trigger
    LANGUAGE plpgsql
    SET search_path TO 'pg_catalog'
    AS $$
        BEGIN
          RAISE EXCEPTION 'source identity ownership is immutable' USING ERRCODE='42501';
        END $$;


--
-- Name: reject_publication_mutation(); Type: FUNCTION; Schema: galactica_security; Owner: -
--

CREATE FUNCTION galactica_security.reject_publication_mutation() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
        BEGIN
          RAISE EXCEPTION 'versioned publication evidence is immutable';
        END;
        $$;


--
-- Name: reject_s8_delegation_rebind(); Type: FUNCTION; Schema: galactica_security; Owner: -
--

CREATE FUNCTION galactica_security.reject_s8_delegation_rebind() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
        BEGIN
          IF NEW.account_id IS DISTINCT FROM OLD.account_id
             OR NEW.project_id IS DISTINCT FROM OLD.project_id
             OR NEW.knowledge_domain_id IS DISTINCT FROM OLD.knowledge_domain_id
             OR NEW.owner_principal_id IS DISTINCT FROM OLD.owner_principal_id
             OR NEW.delegation_context IS DISTINCT FROM OLD.delegation_context
             OR NEW.source_dependencies IS DISTINCT FROM OLD.source_dependencies
             OR NEW.result_audience IS DISTINCT FROM OLD.result_audience
             OR NEW.policy_revision IS DISTINCT FROM OLD.policy_revision THEN
            RAISE EXCEPTION 'S8 delegation is immutable';
          END IF;
          RETURN NEW;
        END;
        $$;


--
-- Name: reject_s8_run_rebind(); Type: FUNCTION; Schema: galactica_security; Owner: -
--

CREATE FUNCTION galactica_security.reject_s8_run_rebind() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
        BEGIN
          IF NEW.account_id IS DISTINCT FROM OLD.account_id
             OR NEW.project_id IS DISTINCT FROM OLD.project_id
             OR NEW.owner_principal_id IS DISTINCT FROM OLD.owner_principal_id
             OR NEW.delegation_context IS DISTINCT FROM OLD.delegation_context
             OR NEW.source_dependencies IS DISTINCT FROM OLD.source_dependencies
             OR NEW.result_audience IS DISTINCT FROM OLD.result_audience
             OR NEW.policy_revision IS DISTINCT FROM OLD.policy_revision THEN
            RAISE EXCEPTION 'S8 run delegation is immutable';
          END IF;
          RETURN NEW;
        END;
        $$;


--
-- Name: reject_service_permission_delete(); Type: FUNCTION; Schema: galactica_security; Owner: -
--

CREATE FUNCTION galactica_security.reject_service_permission_delete() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
        BEGIN RAISE EXCEPTION 'service permission history is append only; revoke instead'; END $$;


--
-- Name: row_allowed(uuid, uuid, uuid, text); Type: FUNCTION; Schema: galactica_security; Owner: -
--

CREATE FUNCTION galactica_security.row_allowed(row_account_id uuid, row_project_id uuid, row_domain_id uuid, required_action text) RETURNS boolean
    LANGUAGE sql STABLE SECURITY DEFINER PARALLEL RESTRICTED
    SET search_path TO 'pg_catalog', 'public', 'galactica_security'
    AS $$
          SELECT EXISTS (
            SELECT 1
            FROM galactica_security.request_contexts ctx
            JOIN public.auth_credentials c
              ON c.id = ctx.credential_id AND c.revoked_at IS NULL
                 AND c.expires_at > clock_timestamp()
            JOIN public.access_principals effective_p
              ON effective_p.id = ctx.effective_principal_id
                 AND effective_p.status = 'active'
            JOIN public.access_principals user_p
              ON user_p.id = ctx.user_principal_id AND user_p.kind = 'user'
                 AND user_p.status = 'active'
            JOIN public.account_memberships m
              ON m.principal_id = ctx.user_principal_id
                 AND m.account_id = ctx.account_id AND m.status = 'active'
            WHERE ctx.backend_pid = pg_backend_pid()
              AND ctx.transaction_id = pg_current_xact_id()
              AND ctx.expires_at > clock_timestamp()
              AND ctx.account_id = row_account_id
              AND ctx.project_id = row_project_id
              AND galactica_security.action_covers(ctx.requested_action, required_action)
              AND (
                ctx.agent_connection_id IS NULL
                OR EXISTS (
                  SELECT 1 FROM public.agent_connections ac
                  WHERE ac.id = ctx.agent_connection_id
                    AND ac.credential_id = ctx.credential_id
                    AND ac.user_principal_id = ctx.user_principal_id
                    AND ac.agent_principal_id = ctx.effective_principal_id
                    AND ac.account_id = ctx.account_id
                    AND ac.project_id = ctx.project_id
                    AND ac.status = 'active' AND ac.expires_at > clock_timestamp()
                    AND ac.auth_revision = ctx.auth_revision
                    AND required_action = ANY(ac.allowed_actions)
                )
              )
              AND EXISTS (
                SELECT 1 FROM public.access_grants g
                WHERE g.principal_id = ctx.user_principal_id
                  AND g.account_id = row_account_id AND g.status = 'active'
                  AND required_action = ANY(g.actions)
                  AND (
                    (g.resource_type = 'account' AND g.resource_id = row_account_id)
                    OR (
                      g.project_id = row_project_id AND (
                        (g.resource_type = 'project' AND g.resource_id = row_project_id)
                        OR (g.resource_type = 'knowledge_domain'
                            AND row_domain_id IS NOT NULL
                            AND g.resource_id = row_domain_id)
                      )
                    )
                  )
              )
          )
        $$;


--
-- Name: valid_service_actions(text[]); Type: FUNCTION; Schema: galactica_security; Owner: -
--

CREATE FUNCTION galactica_security.valid_service_actions(value text[]) RETURNS boolean
    LANGUAGE sql IMMUTABLE STRICT
    SET search_path TO 'pg_catalog'
    AS $$
          SELECT cardinality(value) BETWEEN 1 AND 6
            AND array_position(value,NULL) IS NULL
            AND value <@ ARRAY['read','write','manage','publish','export','execute']::text[]
            AND cardinality(value)=(SELECT count(DISTINCT action) FROM unnest(value) action)
        $$;


--
-- Name: validate_publication_approval(); Type: FUNCTION; Schema: galactica_security; Owner: -
--

CREATE FUNCTION galactica_security.validate_publication_approval() RETURNS trigger
    LANGUAGE plpgsql SECURITY DEFINER
    SET search_path TO 'pg_catalog', 'public', 'galactica_security'
    AS $$
        DECLARE version publication_versions%ROWTYPE;
        DECLARE request publication_requests%ROWTYPE;
        DECLARE approver_kind TEXT;
        BEGIN
          SELECT * INTO version FROM publication_versions
            WHERE id=NEW.publication_version_id;
          SELECT * INTO request FROM publication_requests
            WHERE id=version.publication_request_id;
          SELECT kind INTO approver_kind FROM access_principals
            WHERE id=NEW.approver_principal_id AND status='active';
          IF version.id IS NULL OR approver_kind IS DISTINCT FROM 'user'
             OR NEW.account_id<>version.account_id OR NEW.project_id<>version.project_id
             OR NEW.owner_principal_id<>version.owner_principal_id
             OR NEW.approved_fingerprint<>version.content_fingerprint
             OR NEW.approved_audience<>request.target_audience THEN
            RAISE EXCEPTION 'invalid human publication approval';
          END IF;
          IF NOT EXISTS (
            SELECT 1 FROM access_grants grant_row
            WHERE grant_row.principal_id=NEW.approver_principal_id
              AND grant_row.account_id=NEW.account_id
              AND grant_row.project_id=NEW.project_id
              AND grant_row.status='active' AND 'publish'=ANY(grant_row.actions)
          ) THEN
            RAISE EXCEPTION 'approver lacks current publish permission';
          END IF;
          RETURN NEW;
        END;
        $$;


--
-- Name: validate_publication_manifest(); Type: FUNCTION; Schema: galactica_security; Owner: -
--

CREATE FUNCTION galactica_security.validate_publication_manifest() RETURNS trigger
    LANGUAGE plpgsql SECURITY DEFINER
    SET search_path TO 'pg_catalog', 'public', 'galactica_security'
    AS $$
        DECLARE version publication_versions%ROWTYPE;
        DECLARE approval publication_approvals%ROWTYPE;
        DECLARE request publication_requests%ROWTYPE;
        BEGIN
          SELECT * INTO version FROM publication_versions
            WHERE id=NEW.publication_version_id;
          SELECT * INTO approval FROM publication_approvals
            WHERE id=NEW.approval_id AND publication_version_id=version.id
              AND status='approved';
          SELECT * INTO request FROM publication_requests
            WHERE id=version.publication_request_id;
          IF version.id IS NULL OR approval.id IS NULL
             OR approval.approved_fingerprint<>version.content_fingerprint
             OR approval.approved_audience<>request.target_audience
             OR NEW.account_id<>version.account_id OR NEW.project_id<>version.project_id
             OR NEW.target_audience<>request.target_audience
             OR NEW.content_fingerprint<>version.content_fingerprint
             OR NEW.safe_content<>version.safe_content
             OR NEW.provenance<>version.provenance THEN
            RAISE EXCEPTION 'publication manifest does not match approved version';
          END IF;
          RETURN NEW;
        END;
        $$;


--
-- Name: validate_publication_request(); Type: FUNCTION; Schema: galactica_security; Owner: -
--

CREATE FUNCTION galactica_security.validate_publication_request() RETURNS trigger
    LANGUAGE plpgsql SECURITY DEFINER
    SET search_path TO 'pg_catalog', 'public', 'galactica_security'
    AS $$
        DECLARE item knowledge_items%ROWTYPE;
        BEGIN
          IF NEW.source_resource_type<>'knowledge_item'
             OR NEW.target_audience<>'internal_commons' THEN
            RAISE EXCEPTION 'unsupported publication source or audience';
          END IF;
          SELECT * INTO item FROM knowledge_items WHERE id=NEW.source_resource_id;
          IF item.id IS NULL OR item.account_id<>NEW.account_id
             OR item.project_id<>NEW.project_id OR item.visibility_scope='quarantine'
             OR (item.visibility_scope='private'
                 AND item.owner_principal_id<>NEW.owner_principal_id) THEN
            RAISE EXCEPTION 'publication source is outside owner scope';
          END IF;
          IF NOT EXISTS (
            SELECT 1 FROM access_principals principal
            WHERE principal.id=NEW.owner_principal_id
              AND principal.kind='user' AND principal.status='active'
          ) OR NOT EXISTS (
            SELECT 1 FROM access_grants grant_row
            WHERE grant_row.principal_id=NEW.owner_principal_id
              AND grant_row.account_id=NEW.account_id
              AND grant_row.project_id=NEW.project_id
              AND grant_row.status='active' AND 'publish'=ANY(grant_row.actions)
          ) THEN
            RAISE EXCEPTION 'publication owner lacks current publish permission';
          END IF;
          RETURN NEW;
        END;
        $$;


--
-- Name: validate_publication_version(); Type: FUNCTION; Schema: galactica_security; Owner: -
--

CREATE FUNCTION galactica_security.validate_publication_version() RETURNS trigger
    LANGUAGE plpgsql SECURITY DEFINER
    SET search_path TO 'pg_catalog', 'public', 'galactica_security'
    AS $$
        DECLARE request publication_requests%ROWTYPE;
        BEGIN
          SELECT * INTO request FROM publication_requests
            WHERE id=NEW.publication_request_id;
          IF request.id IS NULL OR request.account_id<>NEW.account_id
             OR request.project_id<>NEW.project_id
             OR request.owner_principal_id<>NEW.owner_principal_id THEN
            RAISE EXCEPTION 'publication version scope mismatch';
          END IF;
          RETURN NEW;
        END;
        $$;


--
-- Name: validate_service_connection_policy(); Type: FUNCTION; Schema: galactica_security; Owner: -
--

CREATE FUNCTION galactica_security.validate_service_connection_policy() RETURNS trigger
    LANGUAGE plpgsql SECURITY DEFINER
    SET search_path TO 'pg_catalog', 'public', 'galactica_security'
    AS $$
        DECLARE link source_identity_links%ROWTYPE;
        DECLARE secret secret_references%ROWTYPE;
        BEGIN
          SELECT * INTO link FROM source_identity_links WHERE id=NEW.source_identity_link_id;
          SELECT * INTO secret FROM secret_references
            WHERE id=link.adapter_secret_reference_id;
          IF link.id IS NULL OR link.user_principal_id<>NEW.owner_principal_id
             OR link.account_id<>NEW.account_id OR link.service_key<>NEW.service_key
             OR secret.id IS NULL OR secret.account_id<>NEW.account_id THEN
            RAISE EXCEPTION 'invalid owner-bound service connection policy';
          END IF;
          IF TG_OP='UPDATE' AND (
             NEW.source_identity_link_id IS DISTINCT FROM OLD.source_identity_link_id
             OR NEW.owner_principal_id IS DISTINCT FROM OLD.owner_principal_id
             OR NEW.account_id IS DISTINCT FROM OLD.account_id
             OR NEW.project_id IS DISTINCT FROM OLD.project_id
             OR NEW.service_key IS DISTINCT FROM OLD.service_key) THEN
            RAISE EXCEPTION 'service connection scope is immutable';
          END IF;
          RETURN NEW;
        END;
        $$;


--
-- Name: assign_general_knowledge_domain(); Type: FUNCTION; Schema: public; Owner: -
--

CREATE FUNCTION public.assign_general_knowledge_domain() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
        BEGIN
          IF NEW.knowledge_domain_id IS NULL THEN
            SELECT id INTO NEW.knowledge_domain_id
            FROM knowledge_domains
            WHERE project_id = NEW.project_id AND slug = 'general';
          END IF;
          RETURN NEW;
        END;
        $$;


--
-- Name: create_general_knowledge_domain(); Type: FUNCTION; Schema: public; Owner: -
--

CREATE FUNCTION public.create_general_knowledge_domain() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
        BEGIN
          INSERT INTO knowledge_domains (project_id, slug, name, description)
          VALUES (NEW.id, 'general', 'General', 'Default knowledge domain');
          RETURN NEW;
        END;
        $$;


--
-- Name: enforce_expert_model_assignment(); Type: FUNCTION; Schema: public; Owner: -
--

CREATE FUNCTION public.enforce_expert_model_assignment() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
        DECLARE model_is_human_only BOOLEAN; model_mode TEXT; canary_enabled BOOLEAN;
        BEGIN
          SELECT human_only, execution_mode INTO model_is_human_only, model_mode
          FROM expert_model_catalog WHERE model_key = NEW.model_key;
          IF model_is_human_only AND NEW.source <> 'human_directive' THEN
            RAISE EXCEPTION 'T4 model assignment requires a human directive' USING ERRCODE = 'check_violation';
          END IF;
          IF NEW.executable THEN
            SELECT enabled INTO canary_enabled FROM expert_feature_flags
            WHERE flag_key = 'expert_canary_execution';
            IF NOT COALESCE(canary_enabled, FALSE) OR model_mode <> 'canary' THEN
              RAISE EXCEPTION 'provider execution is disabled outside a canary' USING ERRCODE = 'check_violation';
            END IF;
          END IF;
          RETURN NEW;
        END; $$;


--
-- Name: enforce_expert_roster_cap(); Type: FUNCTION; Schema: public; Owner: -
--

CREATE FUNCTION public.enforce_expert_roster_cap() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
        DECLARE
          permanent_limit INTEGER;
          candidate_limit INTEGER;
          permanent_count INTEGER;
          candidate_count INTEGER;
          active_states TEXT[] := ARRAY['probation', 'active', 'remediation', 'restricted'];
        BEGIN
          PERFORM pg_advisory_xact_lock(820260815);
          SELECT permanent_cap, candidate_cap
            INTO permanent_limit, candidate_limit
            FROM expert_roster_policies
            WHERE id = 1;
          IF permanent_limit IS NULL OR candidate_limit IS NULL THEN
            RAISE EXCEPTION 'expert roster policy is not initialized';
          END IF;
          IF NEW.lifecycle_state <> ALL(active_states) THEN
            RETURN NEW;
          END IF;
          SELECT COUNT(*) INTO permanent_count
          FROM expert_profiles
          WHERE id IS DISTINCT FROM NEW.id
            AND profile_type = 'permanent'
            AND lifecycle_state = ANY(active_states);
          SELECT COUNT(*) INTO candidate_count
          FROM expert_profiles
          WHERE id IS DISTINCT FROM NEW.id
            AND profile_type = 'candidate'
            AND lifecycle_state = ANY(active_states);
          IF NEW.profile_type = 'permanent' THEN
            permanent_count := permanent_count + 1;
          ELSE
            candidate_count := candidate_count + 1;
          END IF;
          IF permanent_count > permanent_limit THEN
            RAISE EXCEPTION 'expert permanent roster cap exceeded: % > %',
              permanent_count, permanent_limit USING ERRCODE = 'check_violation';
          END IF;
          IF candidate_count > candidate_limit THEN
            RAISE EXCEPTION 'expert candidate roster cap exceeded: % > %',
              candidate_count, candidate_limit USING ERRCODE = 'check_violation';
          END IF;
          IF permanent_count + candidate_count > permanent_limit + candidate_limit THEN
            RAISE EXCEPTION 'expert total roster cap exceeded: % > %',
              permanent_count + candidate_count, permanent_limit + candidate_limit
              USING ERRCODE = 'check_violation';
          END IF;
          RETURN NEW;
        END;
        $$;


--
-- Name: enforce_knowledge_privacy_lineage(); Type: FUNCTION; Schema: public; Owner: -
--

CREATE FUNCTION public.enforce_knowledge_privacy_lineage() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
        DECLARE source_row record;
        BEGIN
          IF NEW.source_session_id IS NOT NULL THEN
            SELECT account_id,project_id,visibility_scope,owner_principal_id,
                   knowledge_domain_id,privacy_lineage
              INTO source_row FROM sessions WHERE id=NEW.source_session_id;
            IF source_row IS NULL THEN
              RAISE EXCEPTION 'knowledge source session is missing';
            END IF;
            IF NEW.account_id IS DISTINCT FROM source_row.account_id OR
               NEW.project_id IS DISTINCT FROM source_row.project_id OR
               NEW.visibility_scope IS DISTINCT FROM source_row.visibility_scope OR
               NEW.owner_principal_id IS DISTINCT FROM source_row.owner_principal_id OR
               NEW.knowledge_domain_id IS DISTINCT FROM source_row.knowledge_domain_id THEN
              RAISE EXCEPTION 'knowledge privacy lineage differs from source session';
            END IF;
          END IF;
          IF TG_OP='UPDATE' AND (
            NEW.owner_principal_id IS DISTINCT FROM OLD.owner_principal_id OR
            NEW.privacy_lineage IS DISTINCT FROM OLD.privacy_lineage OR
            NEW.visibility_scope IS DISTINCT FROM OLD.visibility_scope OR
            NEW.knowledge_domain_id IS DISTINCT FROM OLD.knowledge_domain_id OR
            NEW.source_session_id IS DISTINCT FROM OLD.source_session_id
          ) THEN
            RAISE EXCEPTION 'knowledge privacy lineage is immutable';
          END IF;
          RETURN NEW;
        END $$;


--
-- Name: enforce_project_account_scope(); Type: FUNCTION; Schema: public; Owner: -
--

CREATE FUNCTION public.enforce_project_account_scope() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
        DECLARE
          project_account UUID;
          project_visibility TEXT;
        BEGIN
          SELECT account_id, visibility_scope
          INTO project_account, project_visibility
          FROM projects WHERE id = NEW.project_id;
          IF project_account IS NULL THEN
            RAISE EXCEPTION 'Unknown project_id %', NEW.project_id;
          END IF;
          IF NEW.account_id IS NULL THEN
            NEW.account_id := project_account;
          ELSIF NEW.account_id <> project_account THEN
            RAISE EXCEPTION 'account_id % does not own project %',
              NEW.account_id, NEW.project_id;
          END IF;
          IF NEW.visibility_scope IS NULL THEN
            NEW.visibility_scope := project_visibility;
          END IF;
          IF NEW.visibility_scope = 'commons'
             AND project_account <> '393f72ed-b1fb-5fc1-9cc9-9feddb4e0fed'::uuid THEN
            RAISE EXCEPTION 'commons visibility requires the system-commons account';
          END IF;
          RETURN NEW;
        END;
        $$;


--
-- Name: enforce_semantic_privacy_lineage(); Type: FUNCTION; Schema: public; Owner: -
--

CREATE FUNCTION public.enforce_semantic_privacy_lineage() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
        DECLARE source_row record;
        BEGIN
          IF NEW.source_table='sessions' THEN
            SELECT account_id,project_id,visibility_scope,owner_principal_id,
                   knowledge_domain_id INTO source_row FROM sessions WHERE id=NEW.id;
          ELSIF NEW.source_table='knowledge_items' THEN
            SELECT account_id,project_id,visibility_scope,owner_principal_id,
                   knowledge_domain_id INTO source_row FROM knowledge_items WHERE id=NEW.id;
          ELSE
            RETURN NEW;
          END IF;
          IF source_row IS NULL OR
             NEW.account_id IS DISTINCT FROM source_row.account_id OR
             NEW.project_id IS DISTINCT FROM source_row.project_id OR
             NEW.visibility_scope IS DISTINCT FROM source_row.visibility_scope OR
             NEW.owner_principal_id IS DISTINCT FROM source_row.owner_principal_id OR
             NEW.knowledge_domain_id IS DISTINCT FROM source_row.knowledge_domain_id THEN
            RAISE EXCEPTION 'semantic privacy lineage differs from canonical source';
          END IF;
          IF TG_OP='UPDATE' AND (
            NEW.owner_principal_id IS DISTINCT FROM OLD.owner_principal_id OR
            NEW.privacy_lineage IS DISTINCT FROM OLD.privacy_lineage OR
            NEW.visibility_scope IS DISTINCT FROM OLD.visibility_scope OR
            NEW.knowledge_domain_id IS DISTINCT FROM OLD.knowledge_domain_id
          ) THEN
            RAISE EXCEPTION 'semantic privacy lineage is immutable';
          END IF;
          RETURN NEW;
        END $$;


--
-- Name: enforce_session_privacy_lineage(); Type: FUNCTION; Schema: public; Owner: -
--

CREATE FUNCTION public.enforce_session_privacy_lineage() RETURNS trigger
    LANGUAGE plpgsql SECURITY DEFINER
    SET search_path TO 'pg_catalog', 'public'
    AS $$
        DECLARE
          principal_kind text;
          linked_owner uuid;
          linked_account uuid;
        BEGIN
          IF NEW.visibility_scope <> 'quarantine' THEN
            SELECT kind INTO principal_kind FROM access_principals
              WHERE id=NEW.owner_principal_id AND status='active';
            IF principal_kind <> 'user' OR NOT EXISTS (
              SELECT 1 FROM account_memberships m
              WHERE m.principal_id=NEW.owner_principal_id
                AND m.account_id=NEW.account_id AND m.status='active'
            ) THEN
              RAISE EXCEPTION 'session owner is not an active account member';
            END IF;
            IF NEW.knowledge_domain_id IS NULL THEN
              RAISE EXCEPTION 'session knowledge domain is required';
            END IF;
          END IF;
          IF NEW.source_identity_link_id IS NOT NULL THEN
            SELECT user_principal_id, account_id INTO linked_owner, linked_account
            FROM source_identity_links
            WHERE id=NEW.source_identity_link_id AND status='verified';
            IF linked_owner IS DISTINCT FROM NEW.owner_principal_id
               OR linked_account IS DISTINCT FROM NEW.account_id THEN
              RAISE EXCEPTION 'source identity does not match session owner/account';
            END IF;
          END IF;
          IF TG_OP='UPDATE' AND (
            NEW.owner_principal_id IS DISTINCT FROM OLD.owner_principal_id OR
            NEW.knowledge_domain_id IS DISTINCT FROM OLD.knowledge_domain_id OR
            NEW.source_identity_link_id IS DISTINCT FROM OLD.source_identity_link_id OR
            NEW.ingestion_kind IS DISTINCT FROM OLD.ingestion_kind OR
            NEW.privacy_lineage IS DISTINCT FROM OLD.privacy_lineage OR
            NEW.visibility_scope IS DISTINCT FROM OLD.visibility_scope
          ) THEN
            RAISE EXCEPTION 'session privacy lineage is immutable';
          END IF;
          RETURN NEW;
        END $$;


--
-- Name: enforce_user_bound_identity(); Type: FUNCTION; Schema: public; Owner: -
--

CREATE FUNCTION public.enforce_user_bound_identity() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
        DECLARE
          user_kind TEXT;
          agent_kind_value TEXT;
          credential_principal UUID;
          secret_account UUID;
        BEGIN
          IF TG_TABLE_NAME = 'agent_connections' THEN
            SELECT kind INTO user_kind FROM access_principals WHERE id = NEW.user_principal_id;
            SELECT kind INTO agent_kind_value FROM access_principals
              WHERE id = NEW.agent_principal_id;
            SELECT principal_id INTO credential_principal FROM auth_credentials
              WHERE id = NEW.credential_id AND kind = 'agent';
            IF user_kind <> 'user' OR agent_kind_value <> 'agent'
               OR credential_principal <> NEW.agent_principal_id THEN
              RAISE EXCEPTION 'invalid user-bound agent connection';
            END IF;
          ELSIF TG_TABLE_NAME = 'source_identity_links' THEN
            SELECT kind INTO user_kind FROM access_principals WHERE id = NEW.user_principal_id;
            SELECT account_id INTO secret_account FROM secret_references
              WHERE id = NEW.adapter_secret_reference_id;
            IF user_kind <> 'user' OR secret_account <> NEW.account_id THEN
              RAISE EXCEPTION 'invalid scoped source identity link';
            END IF;
          END IF;
          RETURN NEW;
        END;
        $$;


--
-- Name: enqueue_laptop_federation_projection(); Type: FUNCTION; Schema: public; Owner: -
--

CREATE FUNCTION public.enqueue_laptop_federation_projection() RETURNS trigger
    LANGUAGE plpgsql SECURITY DEFINER
    SET search_path TO 'pg_catalog', 'public'
    AS $$
BEGIN
  IF NEW.privacy_lineage->>'source' = 'laptop_federation_v1' THEN
    IF NEW.project_id <> '@@PROJECT_ID@@'::uuid
       OR NEW.source_table <> 'knowledge_items'
       OR NEW.privacy_lineage->>'origin' <> 'CLIENT-NOTEBOOK' THEN
      RAISE EXCEPTION 'Invalid laptop federation projection boundary';
    END IF;
    INSERT INTO public.index_outbox(entity_type,entity_id,target,operation,idempotency_key,payload)
    VALUES('semantic_node',NEW.id,'qdrant','upsert',
       'semantic_node:'||NEW.id::text||':qdrant:upsert:v1',
       '{"schema_version":"2.0","projection_generation":"v1"}'::jsonb)
    ON CONFLICT(idempotency_key) DO NOTHING;
  END IF;
  RETURN NEW;
END $$;


--
-- Name: expert_lifecycle_events_append_only(); Type: FUNCTION; Schema: public; Owner: -
--

CREATE FUNCTION public.expert_lifecycle_events_append_only() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
        BEGIN
          RAISE EXCEPTION 'expert_lifecycle_events is append-only'
            USING ERRCODE = 'feature_not_supported';
        END;
        $$;


--
-- Name: log_laptop_federation_session_change(); Type: FUNCTION; Schema: public; Owner: -
--

CREATE FUNCTION public.log_laptop_federation_session_change() RETURNS trigger
    LANGUAGE plpgsql SECURITY DEFINER
    SET search_path TO 'pg_catalog', 'public'
    AS $$
DECLARE
    kind text;
BEGIN
    IF NEW.privacy_lineage->>'source' <> 'laptop_federation_v1' THEN
        RETURN NEW;
    END IF;
    IF NEW.project_id <> '@@PROJECT_ID@@'::uuid
       OR NEW.privacy_lineage->>'origin' <> 'CLIENT-NOTEBOOK' THEN
        RAISE EXCEPTION 'Invalid laptop federation change-log boundary';
    END IF;
    kind := COALESCE(
        NULLIF(NEW.privacy_lineage->>'record_kind', ''),
        CASE WHEN NEW.privacy_lineage->>'source_ref' LIKE 'galactica-parent:%'
             THEN 'parent_knowledge' ELSE 'outcome' END
    );
    INSERT INTO public.federation_change_log(
        source_instance, project_id, source_session_id, record_kind,
        sync_eligible, payload_sha256, source_ref, origin, occurred_at
    ) VALUES (
        'sfera-daughter', NEW.project_id, NEW.id, kind,
        kind = 'outcome', NEW.privacy_lineage->>'payload_sha256',
        NEW.privacy_lineage->>'source_ref', NEW.privacy_lineage->>'origin',
        COALESCE(NEW.ended_at, NEW.created_at, clock_timestamp())
    ) ON CONFLICT (source_instance, source_session_id) DO NOTHING;
    RETURN NEW;
END $$;


--
-- Name: refresh_graph_rebuild_progress(); Type: FUNCTION; Schema: public; Owner: -
--

CREATE FUNCTION public.refresh_graph_rebuild_progress() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
        DECLARE
          rebuild_id uuid;
        BEGIN
          IF NEW.payload->>'graph_rebuild_run_id' IS NULL THEN
            RETURN NEW;
          END IF;

          rebuild_id := (NEW.payload->>'graph_rebuild_run_id')::uuid;
          WITH counts AS (
            SELECT
              COUNT(*) FILTER (
                WHERE entity_type = 'knowledge_item' AND status = 'succeeded'
              )::integer AS processed_nodes,
              COUNT(*) FILTER (
                WHERE entity_type = 'knowledge_relation' AND status = 'succeeded'
              )::integer AS processed_edges,
              COUNT(*) FILTER (WHERE status = 'dead')::integer AS failed_jobs
            FROM index_outbox
            WHERE payload->>'graph_rebuild_run_id' = rebuild_id::text
          )
          UPDATE graph_rebuild_runs AS run
          SET
            processed_nodes = counts.processed_nodes,
            processed_edges = counts.processed_edges,
            failed_jobs = counts.failed_jobs,
            status = CASE
              WHEN counts.failed_jobs > 0 THEN 'failed'
              WHEN counts.processed_nodes >= run.total_nodes
               AND counts.processed_edges >= run.total_edges THEN 'succeeded'
              ELSE 'running'
            END,
            finished_at = CASE
              WHEN counts.failed_jobs > 0
                OR (
                  counts.processed_nodes >= run.total_nodes
                  AND counts.processed_edges >= run.total_edges
                )
              THEN COALESCE(run.finished_at, NOW())
              ELSE NULL
            END
          FROM counts
          WHERE run.id = rebuild_id;
          RETURN NEW;
        END;
        $$;


