--
-- Name: acl_audit; Type: ROW SECURITY; Schema: galactica_autonomy; Owner: -
--

ALTER TABLE galactica_autonomy.acl_audit ENABLE ROW LEVEL SECURITY;

--
-- Name: acl_audit acl_audit_read; Type: POLICY; Schema: galactica_autonomy; Owner: -
--

CREATE POLICY acl_audit_read ON galactica_autonomy.acl_audit FOR SELECT TO galactica_ui_acl USING (((current_setting('galactica.acl.admin'::text, true) = 'true'::text) OR (actor = current_setting('galactica.acl.subject'::text, true))));


--
-- Name: acl_audit acl_audit_write; Type: POLICY; Schema: galactica_autonomy; Owner: -
--

CREATE POLICY acl_audit_write ON galactica_autonomy.acl_audit FOR INSERT TO galactica_ui_acl WITH CHECK ((actor = current_setting('galactica.acl.subject'::text, true)));


