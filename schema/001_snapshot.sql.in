-- Name: projection_outbox_id_seq; Type: SEQUENCE; Schema: galactica_autonomy; Owner: -
--

CREATE SEQUENCE galactica_autonomy.projection_outbox_id_seq
    START WITH 1
    INCREMENT BY 1
