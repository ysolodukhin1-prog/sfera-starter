    CONSTRAINT skill_usage_events_rating_before_check CHECK (((rating_before >= 1) AND (rating_before <= 100))),
    CONSTRAINT skill_usage_events_status_check CHECK ((status = ANY (ARRAY['applied'::text, 'evaluated'::text]))),
