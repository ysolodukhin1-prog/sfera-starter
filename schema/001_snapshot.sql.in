    verification_refs text[] DEFAULT '{}'::text[] NOT NULL,
    area_key text NOT NULL,
    classification_basis text,
    CONSTRAINT knowledge_epistemic_status_check CHECK ((epistemic_status = ANY (ARRAY['user_assertion'::text, 'agent_inference'::text, 'verified_fact'::text, 'proposal'::text, 'accepted_decision'::text]))),
    CONSTRAINT knowledge_memory_layer_check CHECK ((memory_layer = ANY (ARRAY['medium'::text, 'long'::text]))),
    CONSTRAINT knowledge_status_check CHECK ((status = ANY (ARRAY['active'::text, 'superseded'::text, 'review'::text])))
);


