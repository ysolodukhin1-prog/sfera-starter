    completeness text NOT NULL,
    redaction_note text,
    received_at timestamp with time zone DEFAULT now() NOT NULL,
    CONSTRAINT client_thread_messages_body_check CHECK (((length(body) >= 1) AND (length(body) <= 50000))),
    CONSTRAINT client_thread_messages_check CHECK (((completeness <> 'redacted'::text) OR (length(redaction_note) > 0))),
    CONSTRAINT client_thread_messages_completeness_check CHECK ((completeness = ANY (ARRAY['exact'::text, 'partial'::text, 'redacted'::text]))),
    CONSTRAINT client_thread_messages_role_check CHECK ((role = ANY (ARRAY['user'::text, 'assistant'::text]))),
    CONSTRAINT client_thread_messages_source_message_id_check CHECK (((length(source_message_id) >= 1) AND (length(source_message_id) <= 200))),
    CONSTRAINT client_thread_messages_source_sequence_check CHECK ((source_sequence >= 0))
);

ALTER TABLE ONLY galactica_autonomy.client_thread_messages FORCE ROW LEVEL SECURITY;


