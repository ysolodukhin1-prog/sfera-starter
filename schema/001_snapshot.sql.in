    CONSTRAINT messages_completeness_check CHECK ((completeness = ANY (ARRAY['exact'::text, 'redacted'::text, 'partial'::text]))),
    CONSTRAINT messages_role_check CHECK ((role = ANY (ARRAY['user'::text, 'assistant'::text, 'system'::text, 'tool'::text])))
);


