    privacy_lineage jsonb DEFAULT '{}'::jsonb NOT NULL,
    CONSTRAINT skill_candidates_latest_version_check CHECK ((latest_version >= 0)),
    CONSTRAINT skill_candidates_status_check CHECK ((status = ANY (ARRAY['candidate'::text, 'available'::text, 'materialized'::text, 'rejected'::text, 'superseded'::text]))),
    CONSTRAINT skill_candidates_visibility_scope_check CHECK ((visibility_scope = ANY (ARRAY['commons'::text, 'account'::text, 'private'::text, 'quarantine'::text])))
);

ALTER TABLE ONLY public.skill_candidates FORCE ROW LEVEL SECURITY;


