    CONSTRAINT client_threads_source_client_check CHECK ((source_client = ANY (ARRAY['codex'::text, 'claude'::text]))),
    CONSTRAINT client_threads_source_thread_id_check CHECK (((length(source_thread_id) >= 1) AND (length(source_thread_id) <= 200)))
);

ALTER TABLE ONLY galactica_autonomy.client_threads FORCE ROW LEVEL SECURITY;


