    CONSTRAINT skill_evidence_assessments_evaluator_check CHECK ((length(btrim(evaluator)) > 0)),
    CONSTRAINT skill_evidence_assessments_evidence_check CHECK (((jsonb_typeof(evidence) = 'object'::text) AND (NOT public.runtime_jsonb_has_forbidden_run_key(evidence)))),
    CONSTRAINT skill_evidence_assessments_evidence_level_check CHECK ((evidence_level = ANY (ARRAY['observed'::text, 'simulated_fixture'::text, 'real_benchmark'::text, 'retention_proven'::text, 'production_stable'::text]))),
    CONSTRAINT skill_evidence_assessments_status_check CHECK ((status = ANY (ARRAY['active'::text, 'superseded'::text, 'rejected'::text])))
);


--
-- Name: skill_transfer_experiments; Type: TABLE; Schema: public; Owner: -
--

CREATE TABLE public.skill_transfer_experiments (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    idempotency_key text NOT NULL,
    skill_version_id uuid NOT NULL,
    status text DEFAULT 'pending_human_approval'::text NOT NULL,
    human_approval_ref text,
    retention_after_days integer NOT NULL,
    baseline_sample_size integer NOT NULL,
    treatment_sample_size integer NOT NULL,
    minimum_uplift numeric(8,6) NOT NULL,
    confidence_level numeric(8,6) NOT NULL,
    randomized boolean DEFAULT true NOT NULL,
    read_only boolean DEFAULT true NOT NULL,
    contract jsonb DEFAULT '{}'::jsonb NOT NULL,
    metrics jsonb DEFAULT '{}'::jsonb NOT NULL,
    attempts integer DEFAULT 0 NOT NULL,
    max_attempts integer DEFAULT 2 NOT NULL,
    last_error text,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL,
    CONSTRAINT skill_transfer_experiments_attempts_check CHECK ((attempts >= 0)),
    CONSTRAINT skill_transfer_experiments_baseline_sample_size_check CHECK ((baseline_sample_size >= 30)),
    CONSTRAINT skill_transfer_experiments_check CHECK (((status = 'pending_human_approval'::text) OR (human_approval_ref IS NOT NULL))),
    CONSTRAINT skill_transfer_experiments_confidence_level_check CHECK (((confidence_level >= 0.90) AND (confidence_level < (1)::numeric))),
    CONSTRAINT skill_transfer_experiments_contract_check CHECK (((jsonb_typeof(contract) = 'object'::text) AND (NOT public.runtime_jsonb_has_forbidden_run_key(contract)))),
    CONSTRAINT skill_transfer_experiments_max_attempts_check CHECK ((max_attempts >= 1)),
    CONSTRAINT skill_transfer_experiments_metrics_check CHECK (((jsonb_typeof(metrics) = 'object'::text) AND (NOT public.runtime_jsonb_has_forbidden_run_key(metrics)))),
    CONSTRAINT skill_transfer_experiments_minimum_uplift_check CHECK (((minimum_uplift > (0)::numeric) AND (minimum_uplift <= (1)::numeric))),
    CONSTRAINT skill_transfer_experiments_randomized_check CHECK (randomized),
    CONSTRAINT skill_transfer_experiments_read_only_check CHECK (read_only),
    CONSTRAINT skill_transfer_experiments_retention_after_days_check CHECK ((retention_after_days >= 1)),
    CONSTRAINT skill_transfer_experiments_status_check CHECK ((status = ANY (ARRAY['pending_human_approval'::text, 'approved'::text, 'running'::text, 'completed'::text, 'failed'::text, 'cancelled'::text]))),
    CONSTRAINT skill_transfer_experiments_treatment_sample_size_check CHECK ((treatment_sample_size >= 30))
);


