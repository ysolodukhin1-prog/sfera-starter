END $$;


--
-- Name: reject_scope_reparent(); Type: FUNCTION; Schema: public; Owner: -
--

CREATE FUNCTION public.reject_scope_reparent() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
        BEGIN
          IF TG_TABLE_NAME = 'projects' AND NEW.account_id <> OLD.account_id THEN
            RAISE EXCEPTION 'project account ownership is immutable';
          ELSIF TG_TABLE_NAME = 'knowledge_domains'
                AND (NEW.project_id <> OLD.project_id OR NEW.account_id <> OLD.account_id) THEN
            RAISE EXCEPTION 'knowledge domain parent scope is immutable';
          END IF;
          RETURN NEW;
        END;
        $$;


--
-- Name: runtime_jsonb_has_forbidden_run_key(jsonb); Type: FUNCTION; Schema: public; Owner: -
--

CREATE FUNCTION public.runtime_jsonb_has_forbidden_run_key(value jsonb) RETURNS boolean
    LANGUAGE plpgsql IMMUTABLE
    SET search_path TO 'pg_catalog', 'public'
    AS $$
        DECLARE
          item JSONB;
          object_key TEXT;
          normalized_key TEXT;
        BEGIN
          IF value IS NULL THEN
            RETURN FALSE;
          END IF;
          IF pg_catalog.jsonb_typeof(value) = 'object' THEN
            FOR object_key, item IN SELECT * FROM pg_catalog.jsonb_each(value)
            LOOP
              normalized_key := pg_catalog.lower(
                pg_catalog.regexp_replace(object_key, '[^a-zA-Z0-9]+', '_', 'g')
              );
              IF normalized_key IN (
                'chain_of_thought', 'reasoning_content', 'hidden_reasoning',
                'password', 'passwd', 'token', 'access_token', 'refresh_token',
                'api_key', 'secret', 'client_secret', 'cookie', 'authorization',
                'private_key'
              ) THEN
                RETURN TRUE;
              END IF;
              IF public.runtime_jsonb_has_forbidden_run_key(item) THEN
                RETURN TRUE;
              END IF;
            END LOOP;
          ELSIF pg_catalog.jsonb_typeof(value) = 'array' THEN
            FOR item IN SELECT * FROM pg_catalog.jsonb_array_elements(value)
            LOOP
              IF public.runtime_jsonb_has_forbidden_run_key(item) THEN
                RETURN TRUE;
              END IF;
            END LOOP;
          END IF;
          RETURN FALSE;
        END;
        $$;


--
-- Name: set_updated_at(); Type: FUNCTION; Schema: public; Owner: -
--

CREATE FUNCTION public.set_updated_at() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
  NEW.updated_at = NOW();
  RETURN NEW;
END;
$$;


SET default_tablespace = '';

SET default_table_access_method = heap;

--
-- Name: acl_audit; Type: TABLE; Schema: galactica_autonomy; Owner: -
--

CREATE TABLE galactica_autonomy.acl_audit (
    id bigint NOT NULL,
    revision bigint NOT NULL,
    actor text NOT NULL,
    operation text NOT NULL,
    before_value jsonb,
    after_value jsonb,
    created_at timestamp with time zone DEFAULT now() NOT NULL
);


--
-- Name: acl_audit_id_seq; Type: SEQUENCE; Schema: galactica_autonomy; Owner: -
--

ALTER TABLE galactica_autonomy.acl_audit ALTER COLUMN id ADD GENERATED ALWAYS AS IDENTITY (
    SEQUENCE NAME galactica_autonomy.acl_audit_id_seq
    START WITH 1
    INCREMENT BY 1
    NO MINVALUE
    NO MAXVALUE
    CACHE 1
);


--
-- Name: acl_group_members; Type: TABLE; Schema: galactica_autonomy; Owner: -
--

CREATE TABLE galactica_autonomy.acl_group_members (
    group_id uuid NOT NULL,
    subject text NOT NULL,
    CONSTRAINT acl_group_members_subject_check CHECK ((subject ~ '^[1-9][0-9]*$'::text))
);


--
-- Name: acl_groups; Type: TABLE; Schema: galactica_autonomy; Owner: -
--

CREATE TABLE galactica_autonomy.acl_groups (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    title text NOT NULL,
    CONSTRAINT acl_groups_title_check CHECK (((length(title) >= 1) AND (length(title) <= 120)))
);


--
-- Name: acl_material_sections; Type: TABLE; Schema: galactica_autonomy; Owner: -
--

CREATE TABLE galactica_autonomy.acl_material_sections (
    kind text NOT NULL,
    resource_key text NOT NULL,
    section_key text NOT NULL,
    CONSTRAINT acl_material_sections_kind_check CHECK ((kind = ANY (ARRAY['knowledge'::text, 'document'::text, 'skill'::text])))
);


--
-- Name: acl_rules; Type: TABLE; Schema: galactica_autonomy; Owner: -
--

CREATE TABLE galactica_autonomy.acl_rules (
